page 86 (
    name: Habilitaciones de período
    alias: HABILITACIONES
    title: Habilitaciones de período
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-periodo-cerrar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Habilitaciones puntuales: permiten a un usuario registrar documentos en un período cerrado hasta una fecha, sin reabrirlo para todos.
            Use Crear habilitación para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Habilitaciones de período
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region habilitaciones (
        name: Habilitaciones de período
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.periodo_habilita_id, pe.modulo, pe.anio, pe.mes, u.username usuario, h.fecha_hasta, h.motivo
                  from erp_gen_periodo_habilita h
                  join erp_gen_periodo pe on pe.periodo_id = h.periodo_id
                  join adm_seg_usuario u on u.usuario_id = h.usuario_id
                 where pe.empresa_id = :APP_EMPRESA_ID
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: habilitaciones
        }
        link {
            linkColumn: customTarget
            target: {
                page: 87
                items: {
                    P87_PERIODO_HABILITA_ID: #PERIODO_HABILITA_ID#
                }
                clearCache: 87
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_periodo_habilita. Alta/edición en la página 87 (guardado automático: catálogo).
                ```
        }

        column PERIODO_HABILITA_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column MODULO (
            type: plainText
            heading {
                heading: Módulo
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Módulo. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ANIO (
            type: plainText
            heading {
                heading: Año
            }
            layout {
                sequence: 30
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Año. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column MES (
            type: plainText
            heading {
                heading: Mes
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Mes. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuario
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Usuario. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FECHA_HASTA (
            type: plainText
            heading {
                heading: Hasta
            }
            layout {
                sequence: 60
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Hasta. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column MOTIVO (
            type: plainText
            heading {
                heading: Motivo
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Motivo. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear habilitación
        layout {
            sequence: 10
            region: @habilitaciones
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 87
                clearCache: 87
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @habilitaciones
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @habilitaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
