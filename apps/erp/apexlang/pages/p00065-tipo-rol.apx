page 65 (
    name: Tipo de rol
    alias: TIPO-ROL
    title: Tipo de rol
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @erp-gen-catalogo-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición: tipo de rol.
            Los campos marcados son obligatorios.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Tipo de rol
        type: form
        source {
            location: localDatabase
            tableName: ERP_GEN_TIPO_ROL
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P65_TIPO_ROL_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: TIPO_ROL_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P65_CODIGO (
        type: textField
        label {
            label: Código
        }
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: CODIGO
            dataType: varchar2
        }
        help {
            inlineHelpText: Ej. CLIENTE
            helpText: Código corto en mayúsculas.
        }
    )

    pageItem P65_NOMBRE (
        type: textField
        label {
            label: Nombre
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: NOMBRE
            dataType: varchar2
        }
        help {
            inlineHelpText: Nombre visible
            helpText: Nombre del rol.
        }
    )

    pageItem P65_ES_VENTAS (
        type: selectList
        label {
            label: Se usa en Ventas
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: ES_VENTAS
            dataType: varchar2
        }
        help {
            inlineHelpText: Sí / No
            helpText: Se ofrece en pedidos y facturas de venta.
        }
    )

    pageItem P65_ES_COMPRAS (
        type: selectList
        label {
            label: Se usa en Compras
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: ES_COMPRAS
            dataType: varchar2
        }
        help {
            inlineHelpText: Sí / No
            helpText: Se ofrece en órdenes y facturas de compra.
        }
    )

    pageItem P65_ES_FINANZAS (
        type: selectList
        label {
            label: Se usa en Finanzas
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: ES_FINANZAS
            dataType: varchar2
        }
        help {
            inlineHelpText: Sí / No
            helpText: Puede tener cuentas a cobrar o a pagar.
        }
    )

    pageItem P65_ES_STOCK (
        type: selectList
        label {
            label: Se usa en Inventario
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: ES_STOCK
            dataType: varchar2
        }
        help {
            inlineHelpText: Sí / No
            helpText: Se ofrece en remisiones y movimientos (ej. transportistas).
        }
    )

    pageItem P65_ESTADO (
        type: selectList
        label {
            label: Estado
        }
        layout {
            sequence: 80
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @estado-ai
        }
        source {
            formRegion: @formulario
            column: ESTADO
            dataType: varchar2
        }
        help {
            inlineHelpText: Activo o inactivo
            helpText: Los registros inactivos no se ofrecen en las listas.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button eliminar (
        buttonName: ELIMINAR
        label: Eliminar
        layout {
            sequence: 20
            region: @botones
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar este registro?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P65_TIPO_ROL_ID
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P65_TIPO_ROL_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P65_TIPO_ROL_ID
        }
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Tipo de rol
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process guardar-datos (
        name: Guardar Tipo de rol
        type: formAutoRowProcessing
        formRegion: @formulario
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
