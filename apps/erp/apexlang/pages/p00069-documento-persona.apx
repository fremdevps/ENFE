page 69 (
    name: Documento adicional
    alias: DOCUMENTO-PERSONA
    title: Documento adicional
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @erp-gen-persona-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición de documentos adicionales.
            El número se valida (formato y dígito verificador) antes de guardar.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Documento adicional
        type: form
        source {
            location: localDatabase
            tableName: ERP_GEN_PERSONA_DOCUMENTO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P69_PERSONA_DOCUMENTO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: PERSONA_DOCUMENTO_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P69_PERSONA_ID (
        type: popupLov
        label {
            label: Persona
        }
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @personas
        }
        source {
            formRegion: @formulario
            column: PERSONA_ID
            dataType: number
        }
        help {
            inlineHelpText: Busque por nombre o documento
            helpText: Persona a la que pertenece el documento.
        }
    )

    pageItem P69_TIPO_DOC_IDENTIDAD_ID (
        type: selectList
        label {
            label: Tipo de documento
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipos-doc-identidad
        }
        source {
            formRegion: @formulario
            column: TIPO_DOC_IDENTIDAD_ID
            dataType: number
        }
        help {
            inlineHelpText: RUC, cédula…
            helpText: Tipo del documento adicional.
        }
    )

    pageItem P69_NRO_DOCUMENTO (
        type: textField
        label {
            label: Número
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: NRO_DOCUMENTO
            dataType: varchar2
        }
        help {
            inlineHelpText: Sin puntos
            helpText: Número del documento, sin dígito verificador.
        }
    )

    pageItem P69_DV (
        type: textField
        label {
            label: Dígito verificador
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: DV
            dataType: varchar2
        }
        help {
            inlineHelpText: Solo RUC
            helpText: Se valida con el algoritmo de la SET.
        }
    )

    pageItem P69_FECHA_DESDE (
        type: datePicker
        label {
            label: Desde
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: FECHA_DESDE
            dataType: date
        }
        help {
            inlineHelpText: Vacío = hoy
            helpText: Desde cuándo es válido.
        }
    )

    pageItem P69_FECHA_HASTA (
        type: datePicker
        label {
            label: Vence
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: FECHA_HASTA
            dataType: date
        }
        help {
            inlineHelpText: Opcional
            helpText: Fecha de vencimiento del documento.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button eliminar (
        buttonName: ELIMINAR
        label: Eliminar
        layout {
            sequence: 20
            region: @botones
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar este registro?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P69_PERSONA_DOCUMENTO_ID
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P69_PERSONA_DOCUMENTO_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P69_PERSONA_DOCUMENTO_ID
        }
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Documento adicional
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process validar-documento (
        name: Validar documento
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                erp_gen_persona_api.validar_documento(
                    i_tipo_doc_identidad_id => :P69_TIPO_DOC_IDENTIDAD_ID,
                    i_nro_documento         => :P69_NRO_DOCUMENTO,
                    i_dv                    => :P69_DV);
                ```
        }
        execution {
            sequence: 5
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR
        }
    )

    process guardar-datos (
        name: Guardar Documento adicional
        type: formAutoRowProcessing
        formRegion: @formulario
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
