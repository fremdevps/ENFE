page 22 (
    name: Funcionalidades activas
    alias: FUNCIONALIDADES-EMPRESA
    title: Funcionalidades activas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-empresa-configurar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Funcionalidades que usa la empresa activa (lotes, vendedores, safra…).
            Use Activar las del rubro para cargar las sugeridas por el rubro de la empresa.
            Use Agregar funcionalidad para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Funcionalidades activas
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region funcionalidades-empresa (
        name: Funcionalidades activas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ef.empresa_func_id, f.nombre funcionalidad, f.codigo, f.modulo, f.descripcion, decode(ef.estado, 'A', 'Activo', 'Inactivo') estado
                  from erp_gen_empresa_func ef
                  join erp_gen_funcionalidad f on f.funcionalidad_id = ef.funcionalidad_id
                 where ef.empresa_id = :APP_EMPRESA_ID
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: funcionalidades-empresa
        }
        link {
            linkColumn: customTarget
            target: {
                page: 23
                items: {
                    P23_EMPRESA_FUNC_ID: #EMPRESA_FUNC_ID#
                }
                clearCache: 23
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_empresa_func. Alta/edición en la página 23 (guardado automático: catálogo).
                ```
        }

        column EMPRESA_FUNC_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column FUNCIONALIDAD (
            type: plainText
            heading {
                heading: Funcionalidad
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Funcionalidad. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column MODULO (
            type: plainText
            heading {
                heading: Módulo
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Módulo. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Qué habilita
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Qué habilita. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Agregar funcionalidad
        layout {
            sequence: 10
            region: @funcionalidades-empresa
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 23
                clearCache: 23
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @funcionalidades-empresa
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @funcionalidades-empresa
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
