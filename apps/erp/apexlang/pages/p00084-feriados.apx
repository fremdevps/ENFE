page 84 (
    name: Feriados
    alias: FERIADOS
    title: Feriados
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-catalogo-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Feriados por país. Se usan para calcular vencimientos, plazos e intereses en días hábiles.
            Use Crear feriado para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Feriados
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region feriados (
        name: Feriados
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select f.feriado_id, p.nombre pais, f.fecha, to_char(f.fecha, 'Day', 'nls_date_language=spanish') dia, f.nombre
                  from erp_gen_feriado f
                  join erp_gen_pais p on p.pais_id = f.pais_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: feriados
        }
        link {
            linkColumn: customTarget
            target: {
                page: 85
                items: {
                    P85_FERIADO_ID: #FERIADO_ID#
                }
                clearCache: 85
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_feriado. Alta/edición en la página 85 (guardado automático: catálogo).
                ```
        }

        column FERIADO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column PAIS (
            type: plainText
            heading {
                heading: País
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: País. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FECHA (
            type: plainText
            heading {
                heading: Fecha
            }
            layout {
                sequence: 30
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Fecha. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DIA (
            type: plainText
            heading {
                heading: Día
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Día. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Motivo
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Motivo. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear feriado
        layout {
            sequence: 10
            region: @feriados
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 85
                clearCache: 85
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @feriados
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @feriados
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
