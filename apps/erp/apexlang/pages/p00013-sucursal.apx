page 13 (
    name: Sucursal
    alias: SUCURSAL
    title: Sucursal
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @erp-gen-empresa-configurar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición: sucursal.
            Los campos marcados son obligatorios.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Sucursal
        type: form
        source {
            location: localDatabase
            tableName: ERP_GEN_SUCURSAL
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P13_SUCURSAL_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: SUCURSAL_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P13_EMPRESA_ID (
        type: hidden
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: EMPRESA_ID
            dataType: number
        }
        default {
            type: item
            item: APP_EMPRESA_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P13_CODIGO (
        type: textField
        label {
            label: Código
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: CODIGO
            dataType: varchar2
        }
        help {
            inlineHelpText: Código interno corto
            helpText: Identificador de la sucursal dentro de la empresa.
        }
    )

    pageItem P13_NOMBRE (
        type: textField
        label {
            label: Nombre
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: NOMBRE
            dataType: varchar2
        }
        help {
            inlineHelpText: Nombre visible
            helpText: Nombre de la sucursal.
        }
    )

    pageItem P13_ESTABLECIMIENTO (
        type: textField
        label {
            label: Establecimiento
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: ESTABLECIMIENTO
            dataType: varchar2
        }
        help {
            inlineHelpText: 3 dígitos, ej. 001
            helpText: Código de establecimiento de los comprobantes (SIFEN/timbrado).
        }
    )

    pageItem P13_DIRECCION (
        type: textarea
        label {
            label: Dirección
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: DIRECCION
            dataType: varchar2
        }
        help {
            inlineHelpText: Calle
            helpText: Dirección de la sucursal.
        }
    )

    pageItem P13_NUMERO_CASA (
        type: textField
        label {
            label: Número de casa
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: NUMERO_CASA
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Número de casa (lo pide SIFEN).
        }
    )

    pageItem P13_UBICACION_ID (
        type: popupLov
        label {
            label: Ciudad
        }
        layout {
            sequence: 80
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @ubicaciones
        }
        source {
            formRegion: @formulario
            column: UBICACION_ID
            dataType: number
        }
        help {
            inlineHelpText: Ciudad
            helpText: Ciudad de la sucursal.
        }
    )

    pageItem P13_TELEFONO (
        type: textField
        label {
            label: Teléfono
        }
        layout {
            sequence: 90
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: TELEFONO
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Teléfono de la sucursal.
        }
    )

    pageItem P13_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 100
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: EMAIL
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Correo de la sucursal.
        }
    )

    pageItem P13_ES_CASA_MATRIZ (
        type: selectList
        label {
            label: Casa matriz
        }
        layout {
            sequence: 110
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: ES_CASA_MATRIZ
            dataType: varchar2
        }
        help {
            inlineHelpText: Sí / No
            helpText: Marque la sucursal principal.
        }
    )

    pageItem P13_ESTADO (
        type: selectList
        label {
            label: Estado
        }
        layout {
            sequence: 120
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @estado-ai
        }
        source {
            formRegion: @formulario
            column: ESTADO
            dataType: varchar2
        }
        help {
            inlineHelpText: Activo o inactivo
            helpText: Los registros inactivos no se ofrecen en las listas.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button eliminar (
        buttonName: ELIMINAR
        label: Eliminar
        layout {
            sequence: 20
            region: @botones
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar este registro?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_SUCURSAL_ID
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P13_SUCURSAL_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P13_SUCURSAL_ID
        }
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Sucursal
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process guardar-datos (
        name: Guardar Sucursal
        type: formAutoRowProcessing
        formRegion: @formulario
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
