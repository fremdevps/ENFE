page 61 (
    name: Persona
    alias: PERSONA
    title: Persona
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @erp-gen-persona-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición de personas.
            El documento se normaliza y se valida (formato y dígito verificador del RUC) antes de guardar.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Persona
        type: form
        source {
            location: localDatabase
            tableName: ERP_GEN_PERSONA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P61_PERSONA_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: PERSONA_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P61_TIPO_PERSONA (
        type: selectList
        label {
            label: Tipo de persona
        }
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: J
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipo-persona
        }
        source {
            formRegion: @formulario
            column: TIPO_PERSONA
            dataType: varchar2
        }
        help {
            inlineHelpText: Física o jurídica
            helpText: Persona física (individuo) o jurídica (empresa, institución).
        }
    )

    pageItem P61_TIPO_DOC_IDENTIDAD_ID (
        type: selectList
        label {
            label: Tipo de documento
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipos-doc-identidad
        }
        source {
            formRegion: @formulario
            column: TIPO_DOC_IDENTIDAD_ID
            dataType: number
        }
        help {
            inlineHelpText: RUC, cédula…
            helpText: Tipo de documento de identidad.
        }
    )

    pageItem P61_NRO_DOCUMENTO (
        type: textField
        label {
            label: Número de documento
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: NRO_DOCUMENTO
            dataType: varchar2
        }
        help {
            inlineHelpText: Sin puntos; puede incluir -DV
            helpText: Si escribe 80012345-6 se separa el dígito verificador automáticamente.
        }
    )

    pageItem P61_DV (
        type: textField
        label {
            label: Dígito verificador
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: DV
            dataType: varchar2
        }
        help {
            inlineHelpText: Solo RUC
            helpText: Se valida con el algoritmo de la SET; si no coincide, no se guarda.
        }
    )

    pageItem P61_RAZON_SOCIAL (
        type: textField
        label {
            label: Razón social
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: RAZON_SOCIAL
            dataType: varchar2
        }
        help {
            inlineHelpText: Jurídica, o vacío para física
            helpText: Para personas físicas puede dejarlo vacío: se arma con nombres y apellidos.
        }
    )

    pageItem P61_NOMBRES (
        type: textField
        label {
            label: Nombres
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: NOMBRES
            dataType: varchar2
        }
        help {
            inlineHelpText: Persona física
            helpText: Nombres de la persona física.
        }
    )

    pageItem P61_APELLIDOS (
        type: textField
        label {
            label: Apellidos
        }
        layout {
            sequence: 80
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: APELLIDOS
            dataType: varchar2
        }
        help {
            inlineHelpText: Persona física
            helpText: Apellidos de la persona física.
        }
    )

    pageItem P61_NOMBRE_FANTASIA (
        type: textField
        label {
            label: Nombre de fantasía
        }
        layout {
            sequence: 90
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: NOMBRE_FANTASIA
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Nombre comercial.
        }
    )

    pageItem P61_ES_CONTRIBUYENTE (
        type: selectList
        label {
            label: Contribuyente de IVA
        }
        layout {
            sequence: 100
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: ES_CONTRIBUYENTE
            dataType: varchar2
        }
        help {
            inlineHelpText: Sí / No
            helpText: Define cómo se informa al receptor en la factura electrónica.
        }
    )

    pageItem P61_PAIS_ID (
        type: selectList
        label {
            label: País
        }
        layout {
            sequence: 110
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @paises
        }
        source {
            formRegion: @formulario
            column: PAIS_ID
            dataType: number
        }
        help {
            inlineHelpText: País de la persona
            helpText: País de residencia o constitución.
        }
    )

    pageItem P61_FECHA_NACIMIENTO (
        type: datePicker
        label {
            label: Fecha de nacimiento / constitución
        }
        layout {
            sequence: 120
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: FECHA_NACIMIENTO
            dataType: date
        }
        help {
            inlineHelpText: Opcional
            helpText: Fecha de nacimiento (física) o de constitución (jurídica).
        }
    )

    pageItem P61_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 130
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: EMAIL
            dataType: varchar2
        }
        help {
            inlineHelpText: Para comprobantes
            helpText: Correo al que se envían los comprobantes electrónicos.
        }
    )

    pageItem P61_TELEFONO (
        type: textField
        label {
            label: Teléfono
        }
        layout {
            sequence: 140
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: TELEFONO
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Teléfono principal.
        }
    )

    pageItem P61_OBSERVACION (
        type: textarea
        label {
            label: Observaciones
        }
        layout {
            sequence: 150
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: OBSERVACION
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Notas internas.
        }
    )

    pageItem P61_ESTADO (
        type: selectList
        label {
            label: Estado
        }
        layout {
            sequence: 160
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @estado-ai
        }
        source {
            formRegion: @formulario
            column: ESTADO
            dataType: varchar2
        }
        help {
            inlineHelpText: Activo o inactivo
            helpText: Los registros inactivos no se ofrecen en las listas.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P61_PERSONA_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P61_PERSONA_ID
        }
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Persona
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process crear-api (
        name: Crear (api)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                erp_gen_persona_api.crear(
                    i_tipo_persona          => :P61_TIPO_PERSONA,
                    i_tipo_doc_identidad_id => :P61_TIPO_DOC_IDENTIDAD_ID,
                    i_nro_documento         => :P61_NRO_DOCUMENTO,
                    i_dv                    => :P61_DV,
                    i_razon_social          => :P61_RAZON_SOCIAL,
                    i_nombres               => :P61_NOMBRES,
                    i_apellidos             => :P61_APELLIDOS,
                    i_nombre_fantasia       => :P61_NOMBRE_FANTASIA,
                    i_es_contribuyente      => :P61_ES_CONTRIBUYENTE,
                    i_pais_id               => :P61_PAIS_ID,
                    i_fecha_nacimiento      => to_date(:P61_FECHA_NACIMIENTO),
                    i_email                 => :P61_EMAIL,
                    i_telefono              => :P61_TELEFONO,
                    i_observacion           => :P61_OBSERVACION,
                    i_estado                => :P61_ESTADO,
                    o_persona_id            => :P61_PERSONA_ID);
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @crear
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process guardar-api (
        name: Guardar (api)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                erp_gen_persona_api.modificar(
                    i_persona_id            => :P61_PERSONA_ID,
                    i_tipo_persona          => :P61_TIPO_PERSONA,
                    i_tipo_doc_identidad_id => :P61_TIPO_DOC_IDENTIDAD_ID,
                    i_nro_documento         => :P61_NRO_DOCUMENTO,
                    i_dv                    => :P61_DV,
                    i_razon_social          => :P61_RAZON_SOCIAL,
                    i_nombres               => :P61_NOMBRES,
                    i_apellidos             => :P61_APELLIDOS,
                    i_nombre_fantasia       => :P61_NOMBRE_FANTASIA,
                    i_es_contribuyente      => :P61_ES_CONTRIBUYENTE,
                    i_pais_id               => :P61_PAIS_ID,
                    i_fecha_nacimiento      => to_date(:P61_FECHA_NACIMIENTO),
                    i_email                 => :P61_EMAIL,
                    i_telefono              => :P61_TELEFONO,
                    i_observacion           => :P61_OBSERVACION,
                    i_estado                => :P61_ESTADO);
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
