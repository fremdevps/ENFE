page 63 (
    name: Rol de persona
    alias: ROL-PERSONA
    title: Rol de persona
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @erp-gen-persona-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición: rol de persona.
            Los campos marcados son obligatorios.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Rol de persona
        type: form
        source {
            location: localDatabase
            tableName: ERP_GEN_PERSONA_ROL
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P63_PERSONA_ROL_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: PERSONA_ROL_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P63_EMPRESA_ID (
        type: hidden
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: EMPRESA_ID
            dataType: number
        }
        default {
            type: item
            item: APP_EMPRESA_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P63_PERSONA_ID (
        type: popupLov
        label {
            label: Persona
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @personas
        }
        source {
            formRegion: @formulario
            column: PERSONA_ID
            dataType: number
        }
        help {
            inlineHelpText: Busque por nombre o documento
            helpText: Persona del padrón.
        }
    )

    pageItem P63_TIPO_ROL_ID (
        type: selectList
        label {
            label: Rol
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipos-rol
        }
        source {
            formRegion: @formulario
            column: TIPO_ROL_ID
            dataType: number
        }
        help {
            inlineHelpText: Cliente, proveedor…
            helpText: Rol que cumple la persona en la empresa activa.
        }
    )

    pageItem P63_CODIGO_INTERNO (
        type: textField
        label {
            label: Código interno
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: CODIGO_INTERNO
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Código de cliente o proveedor en la empresa.
        }
    )

    pageItem P63_FECHA_DESDE (
        type: datePicker
        label {
            label: Desde
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: FECHA_DESDE
            dataType: date
        }
        help {
            inlineHelpText: Vacío = hoy
            helpText: Desde cuándo tiene el rol.
        }
    )

    pageItem P63_ESTADO (
        type: selectList
        label {
            label: Estado
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @estado-ai
        }
        source {
            formRegion: @formulario
            column: ESTADO
            dataType: varchar2
        }
        help {
            inlineHelpText: Activo o inactivo
            helpText: Los registros inactivos no se ofrecen en las listas.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button eliminar (
        buttonName: ELIMINAR
        label: Eliminar
        layout {
            sequence: 20
            region: @botones
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar este registro?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P63_PERSONA_ROL_ID
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P63_PERSONA_ROL_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P63_PERSONA_ROL_ID
        }
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Rol de persona
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process guardar-datos (
        name: Guardar Rol de persona
        type: formAutoRowProcessing
        formRegion: @formulario
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
