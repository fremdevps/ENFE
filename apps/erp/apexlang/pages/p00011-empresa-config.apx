page 11 (
    name: Datos de la empresa
    alias: EMPRESA-CONFIG
    title: Datos de la empresa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @erp-gen-empresa-configurar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición: datos de la empresa.
            Los campos marcados son obligatorios.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Datos de la empresa
        type: form
        source {
            location: localDatabase
            tableName: ERP_GEN_EMPRESA_CONFIG
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P11_EMPRESA_CONFIG_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: EMPRESA_CONFIG_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P11_EMPRESA_ID (
        type: selectList
        label {
            label: Empresa
        }
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @empresas
        }
        source {
            formRegion: @formulario
            column: EMPRESA_ID
            dataType: number
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_EMPRESA_CONFIG_ID
        }
        help {
            inlineHelpText: Empresa de la Administración Central
            helpText: Las empresas se crean en ADM; aquí se completa su configuración del ERP.
        }
    )

    pageItem P11_PAIS_ID (
        type: selectList
        label {
            label: País
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @paises
        }
        source {
            formRegion: @formulario
            column: PAIS_ID
            dataType: number
        }
        help {
            inlineHelpText: País fiscal
            helpText: Define los impuestos, documentos de identidad y ubicaciones disponibles.
        }
    )

    pageItem P11_MONEDA_ID_FUNCIONAL (
        type: selectList
        label {
            label: Moneda funcional
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @monedas
        }
        source {
            formRegion: @formulario
            column: MONEDA_ID_FUNCIONAL
            dataType: number
        }
        help {
            inlineHelpText: Moneda contable
            helpText: Moneda en la que se lleva la contabilidad y se valoriza el stock (PYG en Paraguay).
        }
    )

    pageItem P11_MONEDA_ID_REPORTE (
        type: selectList
        label {
            label: Moneda de reporte
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @monedas
            displayNullValue: true
            nullDisplayValue: - Ninguna -
        }
        source {
            formRegion: @formulario
            column: MONEDA_ID_REPORTE
            dataType: number
        }
        help {
            inlineHelpText: Opcional, ej. USD
            helpText: Segunda moneda para reportes gerenciales y de grupo.
        }
    )

    pageItem P11_RUBRO_ID (
        type: selectList
        label {
            label: Rubro
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @rubros
            displayNullValue: true
            nullDisplayValue: - Sin rubro -
        }
        source {
            formRegion: @formulario
            column: RUBRO_ID
            dataType: number
        }
        help {
            inlineHelpText: Perfil de la empresa
            helpText: Sugiere las funcionalidades a activar (ver Funcionalidades activas).
        }
    )

    pageItem P11_PRECIO_INCLUYE_IMPUESTO (
        type: selectList
        label {
            label: Precios con impuesto incluido
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: S
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: PRECIO_INCLUYE_IMPUESTO
            dataType: varchar2
        }
        help {
            inlineHelpText: Habitual en Paraguay
            helpText: Sí: los precios de venta se cargan con IVA incluido.
        }
    )

    pageItem P11_TIPO_COTIZACION (
        type: selectList
        label {
            label: Cotización por defecto
        }
        layout {
            sequence: 80
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: V
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipo-cotizacion
        }
        source {
            formRegion: @formulario
            column: TIPO_COTIZACION
            dataType: varchar2
        }
        help {
            inlineHelpText: Compra o venta
            helpText: Qué tasa se usa por defecto al convertir monedas.
        }
    )

    pageItem P11_TIPO_CONTRIBUYENTE (
        type: selectList
        label {
            label: Tipo de contribuyente
        }
        layout {
            sequence: 90
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: J
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipo-contribuyente
        }
        source {
            formRegion: @formulario
            column: TIPO_CONTRIBUYENTE
            dataType: varchar2
        }
        help {
            inlineHelpText: Física o jurídica
            helpText: Requerido por la facturación electrónica (SIFEN).
        }
    )

    pageItem P11_DV_RUC (
        type: textField
        label {
            label: DV del RUC
        }
        layout {
            sequence: 100
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: DV_RUC
            dataType: varchar2
        }
        help {
            inlineHelpText: 1 dígito
            helpText: Dígito verificador del RUC cargado en la empresa (ADM).
        }
    )

    pageItem P11_ES_AGENTE_RETENCION (
        type: selectList
        label {
            label: Agente de retención
        }
        layout {
            sequence: 110
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: ES_AGENTE_RETENCION
            dataType: varchar2
        }
        help {
            inlineHelpText: Sí / No
            helpText: Sí si la empresa fue designada agente de retención.
        }
    )

    pageItem P11_ES_EXPORTADOR (
        type: selectList
        label {
            label: Exportador
        }
        layout {
            sequence: 120
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @si-no
        }
        source {
            formRegion: @formulario
            column: ES_EXPORTADOR
            dataType: varchar2
        }
        help {
            inlineHelpText: Sí / No
            helpText: Sí si la empresa realiza exportaciones.
        }
    )

    pageItem P11_DIRECCION (
        type: textarea
        label {
            label: Dirección fiscal
        }
        layout {
            sequence: 130
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: DIRECCION
            dataType: varchar2
        }
        help {
            inlineHelpText: Calle y número
            helpText: Dirección que figura en los comprobantes.
        }
    )

    pageItem P11_UBICACION_ID (
        type: popupLov
        label {
            label: Ciudad
        }
        layout {
            sequence: 140
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @ubicaciones
        }
        source {
            formRegion: @formulario
            column: UBICACION_ID
            dataType: number
        }
        help {
            inlineHelpText: Ciudad fiscal
            helpText: Ciudad de la dirección fiscal.
        }
    )

    pageItem P11_TELEFONO (
        type: textField
        label {
            label: Teléfono
        }
        layout {
            sequence: 150
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: TELEFONO
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Teléfono de contacto.
        }
    )

    pageItem P11_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 160
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: EMAIL
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Correo de la empresa (respuestas de SIFEN, avisos).
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P11_EMPRESA_CONFIG_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P11_EMPRESA_CONFIG_ID
        }
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Datos de la empresa
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process guardar-datos (
        name: Guardar Datos de la empresa
        type: formAutoRowProcessing
        formRegion: @formulario
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
