page 78 (
    name: Funcionalidades por rubro
    alias: RUBRO-FUNCIONALIDADES
    title: Funcionalidades por rubro
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-catalogo-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Qué funcionalidades sugiere cada rubro.
            Use Agregar funcionalidad para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Funcionalidades por rubro
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region rubro-funcionalidades (
        name: Funcionalidades por rubro
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rf.rubro_func_id, r.nombre rubro, f.nombre funcionalidad, f.codigo
                  from erp_gen_rubro_func rf
                  join erp_gen_rubro r on r.rubro_id = rf.rubro_id
                  join erp_gen_funcionalidad f on f.funcionalidad_id = rf.funcionalidad_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: rubro-funcionalidades
        }
        link {
            linkColumn: customTarget
            target: {
                page: 79
                items: {
                    P79_RUBRO_FUNC_ID: #RUBRO_FUNC_ID#
                }
                clearCache: 79
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_rubro_func. Alta/edición en la página 79 (guardado automático: catálogo).
                ```
        }

        column RUBRO_FUNC_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column RUBRO (
            type: plainText
            heading {
                heading: Rubro
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Rubro. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FUNCIONALIDAD (
            type: plainText
            heading {
                heading: Funcionalidad
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Funcionalidad. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Agregar funcionalidad
        layout {
            sequence: 10
            region: @rubro-funcionalidades
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 79
                clearCache: 79
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @rubro-funcionalidades
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rubro-funcionalidades
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
