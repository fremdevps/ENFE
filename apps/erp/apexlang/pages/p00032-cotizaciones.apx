page 32 (
    name: Cotizaciones
    alias: COTIZACIONES
    title: Cotizaciones
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-cotizacion-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Cotizaciones de monedas. Se usa la última cargada a la fecha del documento.
            Use Cargar cotización para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Cotizaciones
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region cotizaciones (
        name: Cotizaciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.cotizacion_id, c.fecha, mo.codigo origen, md.codigo destino, c.tasa_compra, c.tasa_venta,
                       decode(c.fuente, 'BCP', 'Banco Central', 'SET', 'DNIT', 'API', 'Servicio externo', 'Manual') fuente,
                       coalesce(e.razon_social, 'General') ambito
                  from erp_gen_cotizacion c
                  join erp_gen_moneda mo on mo.moneda_id = c.moneda_id_origen
                  join erp_gen_moneda md on md.moneda_id = c.moneda_id_destino
                  left join adm_gen_empresa e on e.empresa_id = c.empresa_id
                 where c.empresa_id is null or c.empresa_id = :APP_EMPRESA_ID
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: cotizaciones
        }
        link {
            linkColumn: customTarget
            target: {
                page: 33
                items: {
                    P33_COTIZACION_ID: #COTIZACION_ID#
                }
                clearCache: 33
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_cotizacion. Alta/edición en la página 33 (guardado automático: catálogo).
                ```
        }

        column COTIZACION_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column FECHA (
            type: plainText
            heading {
                heading: Fecha
            }
            layout {
                sequence: 20
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Fecha. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ORIGEN (
            type: plainText
            heading {
                heading: Moneda
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Moneda. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DESTINO (
            type: plainText
            heading {
                heading: En moneda
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: En moneda. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column TASA_COMPRA (
            type: plainText
            heading {
                heading: Compra
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Compra. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column TASA_VENTA (
            type: plainText
            heading {
                heading: Venta
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Venta. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FUENTE (
            type: plainText
            heading {
                heading: Fuente
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Fuente. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column AMBITO (
            type: plainText
            heading {
                heading: Ámbito
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: General = vale para todas las empresas. Display Label: Ámbito. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Cargar cotización
        layout {
            sequence: 10
            region: @cotizaciones
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 33
                clearCache: 33
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @cotizaciones
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @cotizaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
