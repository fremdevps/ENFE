page 62 (
    name: Roles por empresa
    alias: ROLES-PERSONA
    title: Roles por empresa
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-persona-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Clientes, proveedores, empleados y demás roles de las personas en la empresa activa.
            Use Asignar rol para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Roles por empresa
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region roles-persona (
        name: Roles por empresa
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pr.persona_rol_id, p.razon_social persona, p.nro_documento || nvl2(p.dv, '-' || p.dv, null) documento,
                       tr.nombre rol, pr.codigo_interno, pr.fecha_desde, decode(pr.estado, 'A', 'Activo', 'Inactivo') estado
                  from erp_gen_persona_rol pr
                  join erp_gen_persona p on p.persona_id = pr.persona_id
                  join erp_gen_tipo_rol tr on tr.tipo_rol_id = pr.tipo_rol_id
                 where pr.empresa_id = :APP_EMPRESA_ID
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: roles-persona
        }
        link {
            linkColumn: customTarget
            target: {
                page: 63
                items: {
                    P63_PERSONA_ROL_ID: #PERSONA_ROL_ID#
                }
                clearCache: 63
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_persona_rol. Alta/edición en la página 63 (guardado automático: catálogo).
                ```
        }

        column PERSONA_ROL_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column PERSONA (
            type: plainText
            heading {
                heading: Persona
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Persona. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DOCUMENTO (
            type: plainText
            heading {
                heading: Documento
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Documento. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ROL (
            type: plainText
            heading {
                heading: Rol
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Rol. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column CODIGO_INTERNO (
            type: plainText
            heading {
                heading: Código interno
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código interno. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FECHA_DESDE (
            type: plainText
            heading {
                heading: Desde
            }
            layout {
                sequence: 60
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Desde. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Asignar rol
        layout {
            sequence: 10
            region: @roles-persona
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 63
                clearCache: 63
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @roles-persona
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @roles-persona
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
