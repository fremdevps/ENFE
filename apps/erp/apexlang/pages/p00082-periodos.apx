page 82 (
    name: Períodos
    alias: PERIODOS
    title: Períodos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-periodo-cerrar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Períodos (meses) por módulo de la empresa activa.
            Un período cerrado no admite documentos con fecha en ese mes.
            ```
    }

    region breadcrumb (
        name: Períodos
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region periodos (
        name: Períodos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pe.periodo_id, pe.modulo, pe.anio, pe.mes, to_char(to_date(pe.mes, 'MM'), 'Month', 'nls_date_language=spanish') nombre_mes,
                       decode(pe.estado, 'A', 'Abierto', 'Cerrado') estado, pe.fecha_cierre, pe.cerrado_por
                  from erp_gen_periodo pe
                 where pe.empresa_id = :APP_EMPRESA_ID
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: periodos
        }
        link {
            linkColumn: customTarget
            target: {
                page: 83
                items: {
                    P83_PERIODO_ID: #PERIODO_ID#
                }
                clearCache: 83
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_periodo. Gestión en la página 83 vía erp_gen_periodo_api.
                ```
        }

        column PERIODO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column MODULO (
            type: plainText
            heading {
                heading: Módulo
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Módulo. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ANIO (
            type: plainText
            heading {
                heading: Año
            }
            layout {
                sequence: 30
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Año. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column MES (
            type: plainText
            heading {
                heading: Mes
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Mes. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE_MES (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FECHA_CIERRE (
            type: plainText
            heading {
                heading: Último cierre
            }
            layout {
                sequence: 70
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Último cierre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column CERRADO_POR (
            type: plainText
            heading {
                heading: Cerrado por
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Cerrado por. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Gestionar períodos
        layout {
            sequence: 10
            region: @periodos
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 83
                clearCache: 83
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @periodos
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @periodos
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
