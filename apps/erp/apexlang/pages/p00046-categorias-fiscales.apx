page 46 (
    name: Categorías fiscales
    alias: CATEGORIAS-FISCALES
    title: Categorías fiscales
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-catalogo-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Categorías fiscales: definen cómo tributa cada producto. Sus tasas se cargan en Tasas por categoría.
            Use Crear categoría para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Categorías fiscales
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region categorias-fiscales (
        name: Categorías fiscales
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.categoria_fiscal_id, p.nombre pais, c.codigo, c.nombre,
                       (select listagg(t.codigo || ' sobre ' || ct.porcentaje_base || '%', ', ') within group (order by ct.orden)
                          from erp_gen_categoria_tasa ct join erp_gen_impuesto_tasa t on t.impuesto_tasa_id = ct.impuesto_tasa_id
                         where ct.categoria_fiscal_id = c.categoria_fiscal_id) composicion,
                       decode(c.estado, 'A', 'Activo', 'Inactivo') estado
                  from erp_gen_categoria_fiscal c
                  join erp_gen_pais p on p.pais_id = c.pais_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: categorias-fiscales
        }
        link {
            linkColumn: customTarget
            target: {
                page: 47
                items: {
                    P47_CATEGORIA_FISCAL_ID: #CATEGORIA_FISCAL_ID#
                }
                clearCache: 47
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_categoria_fiscal. Alta/edición en la página 47 (guardado automático: catálogo).
                ```
        }

        column CATEGORIA_FISCAL_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column PAIS (
            type: plainText
            heading {
                heading: País
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: País. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column COMPOSICION (
            type: plainText
            heading {
                heading: Tasas
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: Vacío = exento. Display Label: Tasas. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear categoría
        layout {
            sequence: 10
            region: @categorias-fiscales
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 47
                clearCache: 47
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @categorias-fiscales
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @categorias-fiscales
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
