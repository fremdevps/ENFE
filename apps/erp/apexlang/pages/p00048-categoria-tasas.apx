page 48 (
    name: Tasas por categoría
    alias: CATEGORIA-TASAS
    title: Tasas por categoría
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-catalogo-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Composición de cada categoría fiscal: qué tasas aplican y sobre qué parte de la base.
            Use Agregar tasa para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Tasas por categoría
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region categoria-tasas (
        name: Tasas por categoría
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ct.categoria_tasa_id, c.codigo categoria, i.codigo || ' / ' || t.codigo tasa, ct.porcentaje_base, ct.orden
                  from erp_gen_categoria_tasa ct
                  join erp_gen_categoria_fiscal c on c.categoria_fiscal_id = ct.categoria_fiscal_id
                  join erp_gen_impuesto_tasa t on t.impuesto_tasa_id = ct.impuesto_tasa_id
                  join erp_gen_impuesto i on i.impuesto_id = t.impuesto_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: categoria-tasas
        }
        link {
            linkColumn: customTarget
            target: {
                page: 49
                items: {
                    P49_CATEGORIA_TASA_ID: #CATEGORIA_TASA_ID#
                }
                clearCache: 49
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_categoria_tasa. Alta/edición en la página 49 (guardado automático: catálogo).
                ```
        }

        column CATEGORIA_TASA_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column CATEGORIA (
            type: plainText
            heading {
                heading: Categoría
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Categoría. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column TASA (
            type: plainText
            heading {
                heading: Tasa
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Tasa. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column PORCENTAJE_BASE (
            type: plainText
            heading {
                heading: % de la base
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: % de la base. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ORDEN (
            type: plainText
            heading {
                heading: Orden
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Orden. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Agregar tasa
        layout {
            sequence: 10
            region: @categoria-tasas
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 49
                clearCache: 49
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @categoria-tasas
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @categoria-tasas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
