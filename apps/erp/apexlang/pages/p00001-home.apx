page 1 (
    name: Inicio
    alias: HOME
    title: Inicio
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Configuración general del ERP para la empresa activa.
            Siga los pasos de Puesta en marcha y use las tarjetas para ir a cada configuración. La empresa activa se cambia desde la barra superior.
            ```
    }

    region breadcrumb (
        name: Inicio
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region puesta-en-marcha (
        name: Puesta en marcha
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 1 orden, 'Datos de la empresa (país, monedas, rubro)' paso,
                       case when exists (select 1 from erp_gen_empresa_config where empresa_id = :APP_EMPRESA_ID)
                            then 'Listo' else 'Pendiente' end estado
                  from dual
                union all
                select 2, 'Al menos una sucursal (establecimiento)',
                       case when exists (select 1 from erp_gen_sucursal where empresa_id = :APP_EMPRESA_ID and estado = 'A')
                            then 'Listo' else 'Pendiente' end
                  from dual
                union all
                select 3, 'Punto de expedición por sucursal',
                       case when exists (select 1 from erp_gen_punto_expedicion p join erp_gen_sucursal s on s.sucursal_id = p.sucursal_id
                                          where s.empresa_id = :APP_EMPRESA_ID and p.estado = 'A')
                            then 'Listo' else 'Pendiente' end
                  from dual
                union all
                select 4, 'Depósito principal',
                       case when exists (select 1 from erp_stk_deposito d join erp_gen_sucursal s on s.sucursal_id = d.sucursal_id
                                          where s.empresa_id = :APP_EMPRESA_ID and d.estado = 'A')
                            then 'Listo' else 'Pendiente' end
                  from dual
                union all
                select 5, 'Funcionalidades del rubro activadas',
                       case when exists (select 1 from erp_gen_empresa_func where empresa_id = :APP_EMPRESA_ID and estado = 'A')
                            then 'Listo' else 'Pendiente' end
                  from dual
                union all
                select 6, 'Cotización del día cargada',
                       case when exists (select 1 from erp_gen_cotizacion
                                          where fecha = trunc(current_date) and (empresa_id is null or empresa_id = :APP_EMPRESA_ID))
                            then 'Listo' else 'Pendiente' end
                  from dual
                union all
                select 7, 'Períodos del año creados',
                       case when exists (select 1 from erp_gen_periodo where empresa_id = :APP_EMPRESA_ID and anio = extract(year from current_date))
                            then 'Listo' else 'Pendiente' end
                  from dual
                 order by 1
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: puesta-en-marcha
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column ORDEN (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Paso
                alignment: start
            }
            layout {
                sequence: 10
                columnAlignment: start
            }
        )

        column PASO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Qué configurar
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
        )

        column ESTADO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Estado
                alignment: start
            }
            layout {
                sequence: 30
                columnAlignment: start
            }
        )
    )

    region accesos (
        name: Configuración
        type: list
        source {
            list: @accesos
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: accesos
        }
        componentAppearance {
            listTemplate: @/cards
            templateOptions: [
                #DEFAULT#
                t-Cards--featured force-fa-lg
                t-Cards--displayIcons
                t-Cards--3cols
                t-Cards--desc-2ln
                t-Cards--animColorFill
            ]
        }
    )
)
