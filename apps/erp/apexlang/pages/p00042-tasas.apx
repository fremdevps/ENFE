page 42 (
    name: Tasas
    alias: TASAS
    title: Tasas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-catalogo-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Tasas de cada impuesto. El porcentaje se carga en Vigencias de tasas, con fecha desde.
            Use Crear tasa para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Tasas
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tasas (
        name: Tasas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.impuesto_tasa_id, i.codigo impuesto, t.codigo, t.nombre,
                       (select v.porcentaje from erp_gen_impuesto_tasa_vig v
                         where v.impuesto_tasa_id = t.impuesto_tasa_id and v.fecha_desde <= trunc(current_date)
                         order by v.fecha_desde desc fetch first 1 row only) porcentaje_vigente,
                       t.codigo_oficial, decode(t.estado, 'A', 'Activo', 'Inactivo') estado
                  from erp_gen_impuesto_tasa t
                  join erp_gen_impuesto i on i.impuesto_id = t.impuesto_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: tasas
        }
        link {
            linkColumn: customTarget
            target: {
                page: 43
                items: {
                    P43_IMPUESTO_TASA_ID: #IMPUESTO_TASA_ID#
                }
                clearCache: 43
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_impuesto_tasa. Alta/edición en la página 43 (guardado automático: catálogo).
                ```
        }

        column IMPUESTO_TASA_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column IMPUESTO (
            type: plainText
            heading {
                heading: Impuesto
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Impuesto. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column PORCENTAJE_VIGENTE (
            type: plainText
            heading {
                heading: % vigente hoy
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: % vigente hoy. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column CODIGO_OFICIAL (
            type: plainText
            heading {
                heading: Código SIFEN
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código SIFEN. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear tasa
        layout {
            sequence: 10
            region: @tasas
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 43
                clearCache: 43
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @tasas
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @tasas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
