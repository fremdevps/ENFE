page 68 (
    name: Documentos adicionales
    alias: DOCUMENTOS-PERSONA
    title: Documentos adicionales
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-persona-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Documentos de identidad adicionales de las personas (por ejemplo cédula y RUC, o pasaporte y RUC).
            El documento principal se carga en la persona.
            ```
    }

    region breadcrumb (
        name: Documentos adicionales
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region documentos-persona (
        name: Documentos adicionales
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.persona_documento_id, p.razon_social persona, td.codigo tipo, d.nro_documento || nvl2(d.dv, '-' || d.dv, null) documento,
                       d.fecha_desde, d.fecha_hasta
                  from erp_gen_persona_documento d
                  join erp_gen_persona p on p.persona_id = d.persona_id
                  join erp_gen_tipo_doc_identidad td on td.tipo_doc_identidad_id = d.tipo_doc_identidad_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: documentos-persona
        }
        link {
            linkColumn: customTarget
            target: {
                page: 69
                items: {
                    P69_PERSONA_DOCUMENTO_ID: #PERSONA_DOCUMENTO_ID#
                }
                clearCache: 69
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_persona_documento. Alta/edición en la página 69 con validación vía erp_gen_persona_api.
                ```
        }

        column PERSONA_DOCUMENTO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column PERSONA (
            type: plainText
            heading {
                heading: Persona
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Persona. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column TIPO (
            type: plainText
            heading {
                heading: Tipo
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Tipo. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DOCUMENTO (
            type: plainText
            heading {
                heading: Documento
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Documento. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FECHA_DESDE (
            type: plainText
            heading {
                heading: Desde
            }
            layout {
                sequence: 50
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Desde. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FECHA_HASTA (
            type: plainText
            heading {
                heading: Vence
            }
            layout {
                sequence: 60
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Vence. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Agregar documento
        layout {
            sequence: 10
            region: @documentos-persona
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 69
                clearCache: 69
            }
        }
        security {
            authorizationScheme: @erp-gen-persona-gestionar
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @documentos-persona
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @documentos-persona
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
