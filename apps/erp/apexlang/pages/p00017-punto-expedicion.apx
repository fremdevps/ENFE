page 17 (
    name: Punto de expedición
    alias: PUNTO-EXPEDICION
    title: Punto de expedición
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @erp-gen-empresa-configurar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición: punto de expedición.
            Los campos marcados son obligatorios.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Punto de expedición
        type: form
        source {
            location: localDatabase
            tableName: ERP_GEN_PUNTO_EXPEDICION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P17_PUNTO_EXPEDICION_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: PUNTO_EXPEDICION_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P17_SUCURSAL_ID (
        type: selectList
        label {
            label: Sucursal
        }
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @sucursales
        }
        source {
            formRegion: @formulario
            column: SUCURSAL_ID
            dataType: number
        }
        help {
            inlineHelpText: Establecimiento
            helpText: Sucursal donde se emiten los comprobantes.
        }
    )

    pageItem P17_CODIGO (
        type: textField
        label {
            label: Código
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: CODIGO
            dataType: varchar2
        }
        help {
            inlineHelpText: 3 dígitos, ej. 001
            helpText: Punto de expedición que figura en el número del comprobante (001-001-0000001).
        }
    )

    pageItem P17_NOMBRE (
        type: textField
        label {
            label: Nombre
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: NOMBRE
            dataType: varchar2
        }
        help {
            inlineHelpText: Caja 1, Mostrador…
            helpText: Descripción del punto de emisión.
        }
    )

    pageItem P17_DEPARTAMENTO_ID (
        type: selectList
        label {
            label: Departamento
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @departamentos
            displayNullValue: true
            nullDisplayValue: - Ninguno -
        }
        source {
            formRegion: @formulario
            column: DEPARTAMENTO_ID
            dataType: number
        }
        help {
            inlineHelpText: Opcional
            helpText: Departamento al que pertenece el punto.
        }
    )

    pageItem P17_ESTADO (
        type: selectList
        label {
            label: Estado
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: A
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @estado-ai
        }
        source {
            formRegion: @formulario
            column: ESTADO
            dataType: varchar2
        }
        help {
            inlineHelpText: Activo o inactivo
            helpText: Los registros inactivos no se ofrecen en las listas.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button eliminar (
        buttonName: ELIMINAR
        label: Eliminar
        layout {
            sequence: 20
            region: @botones
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar este registro?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P17_PUNTO_EXPEDICION_ID
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P17_PUNTO_EXPEDICION_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P17_PUNTO_EXPEDICION_ID
        }
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Punto de expedición
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process guardar-datos (
        name: Guardar Punto de expedición
        type: formAutoRowProcessing
        formRegion: @formulario
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
