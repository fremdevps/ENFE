page 80 (
    name: Parámetros
    alias: PARAMETROS
    title: Parámetros
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-empresa-configurar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Parámetros que ajustan el comportamiento del ERP.
            Use Crear parámetro para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Parámetros
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region parametros (
        name: Parámetros
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select pa.parametro_id, pa.codigo, pa.valor,
                       decode(pa.tipo_dato, 'T', 'Texto', 'N', 'Número', 'F', 'Fecha', 'Sí/No') tipo_dato,
                       coalesce(e.razon_social, 'General') ambito, pa.descripcion
                  from erp_gen_parametro pa
                  left join adm_gen_empresa e on e.empresa_id = pa.empresa_id
                 where pa.empresa_id is null or pa.empresa_id = :APP_EMPRESA_ID
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: parametros
        }
        link {
            linkColumn: customTarget
            target: {
                page: 81
                items: {
                    P81_PARAMETRO_ID: #PARAMETRO_ID#
                }
                clearCache: 81
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_parametro. Alta/edición en la página 81 (guardado automático: catálogo).
                ```
        }

        column PARAMETRO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column VALOR (
            type: plainText
            heading {
                heading: Valor
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Valor. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column TIPO_DATO (
            type: plainText
            heading {
                heading: Tipo
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Tipo. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column AMBITO (
            type: plainText
            heading {
                heading: Ámbito
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: El valor de la empresa reemplaza al general. Display Label: Ámbito. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DESCRIPCION (
            type: plainText
            heading {
                heading: Para qué sirve
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Para qué sirve. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear parámetro
        layout {
            sequence: 10
            region: @parametros
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 81
                clearCache: 81
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @parametros
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @parametros
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
