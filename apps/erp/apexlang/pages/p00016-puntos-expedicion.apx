page 16 (
    name: Puntos de expedición
    alias: PUNTOS-EXPEDICION
    title: Puntos de expedición
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @erp-gen-empresa-configurar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Puntos de expedición de comprobantes por sucursal.
            Use Crear punto de expedición para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Puntos de expedición
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region puntos-expedicion (
        name: Puntos de expedición
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.punto_expedicion_id, s.establecimiento || '-' || p.codigo numero, p.nombre, s.nombre sucursal,
                       d.nombre departamento, decode(p.estado, 'A', 'Activo', 'Inactivo') estado
                  from erp_gen_punto_expedicion p
                  join erp_gen_sucursal s on s.sucursal_id = p.sucursal_id
                  left join erp_gen_departamento d on d.departamento_id = p.departamento_id
                 where s.empresa_id = :APP_EMPRESA_ID
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: puntos-expedicion
        }
        link {
            linkColumn: customTarget
            target: {
                page: 17
                items: {
                    P17_PUNTO_EXPEDICION_ID: #PUNTO_EXPEDICION_ID#
                }
                clearCache: 17
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de erp_gen_punto_expedicion. Alta/edición en la página 17 (guardado automático: catálogo).
                ```
        }

        column PUNTO_EXPEDICION_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column NUMERO (
            type: plainText
            heading {
                heading: Número
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: Establecimiento-punto, como en el comprobante. Display Label: Número. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column SUCURSAL (
            type: plainText
            heading {
                heading: Sucursal
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Sucursal. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DEPARTAMENTO (
            type: plainText
            heading {
                heading: Departamento
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Departamento. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear punto de expedición
        layout {
            sequence: 10
            region: @puntos-expedicion
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 17
                clearCache: 17
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @puntos-expedicion
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @puntos-expedicion
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
