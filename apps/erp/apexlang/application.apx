app ERP (
    name: ERP Configuración
    logo {
        type: text
        text: &APP_TITLE.
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--default
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @login-central
    }
    authorization {
        scheme: @acceso-app
        runOnPublicPages: false
    }
    sessionStateProtection {
        checksumSalt: BE8E26C19CF3511FBFEB1A6F9F79DA741A84B7ED70299369E025F6E56E2FFF65
    }
    globalization {
        primaryLanguage: es
        languageDerivedFrom: appPrimaryLanguage
        autoTimeZone: true
        autoCsvEncoding: true
    }
    errorHandling {
        defaultDisplayLocation: inlineWithFieldAndInNotification
        errorHandlingFunctionName: adm_gen_error_api.manejar_error_apex
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 24.2
    }
)

