lov periodos-cerrados (
    name: PERIODOS_CERRADOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select modulo || ' ' || lpad(mes, 2, '0') || '/' || anio d, periodo_id r
              from erp_gen_periodo
             where empresa_id = :APP_EMPRESA_ID
               and estado = 'C'
             order by anio desc, mes desc, modulo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov personas (
    name: PERSONAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select p.razon_social || ' (' || p.nro_documento || nvl2(p.dv, '-' || p.dv, null) || ')' d, p.persona_id r
              from erp_gen_persona p
             where p.estado = 'A'
             order by p.razon_social
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov puntos-expedicion (
    name: PUNTOS_EXPEDICION
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select s.establecimiento || '-' || p.codigo || ' ' || p.nombre d, p.punto_expedicion_id r
              from erp_gen_punto_expedicion p
              join erp_gen_sucursal s on s.sucursal_id = p.sucursal_id
             where s.empresa_id = :APP_EMPRESA_ID
               and p.estado = 'A'
             order by s.establecimiento, p.codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

