lov mis-empresas (
    name: MIS_EMPRESAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select codigo || ' - ' || razon_social d, empresa_id r
              from erp_gen_usuario_empresa_v
             where upper(username) = upper(:APP_USER)
             order by codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov modulos-erp (
    name: MODULOS_ERP
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select m.codigo || ' - ' || m.nombre d, m.codigo r
              from adm_seg_modulo m
              join adm_seg_aplicacion a on a.aplicacion_id = m.aplicacion_id
             where a.codigo = 'ERP'
               and m.estado = 'A'
             order by m.orden
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

