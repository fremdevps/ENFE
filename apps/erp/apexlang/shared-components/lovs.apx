lov ubicaciones (
    name: UBICACIONES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select u.nombre || ' (' || decode(u.tipo, 'DEP', 'Dpto.', 'DIS', 'Distrito', 'Ciudad')
                   || nvl2(p.nombre, ' - ' || p.nombre, null) || ')' d, u.ubicacion_id r
              from erp_gen_ubicacion u
              left join erp_gen_ubicacion p on p.ubicacion_id = u.ubicacion_id_padre
             where u.estado = 'A'
             order by u.nombre
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov usuarios (
