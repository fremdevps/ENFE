lov categorias-fiscales (
    name: CATEGORIAS_FISCALES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select c.codigo || ' - ' || c.nombre || ' (' || p.codigo || ')' d, c.categoria_fiscal_id r
              from erp_gen_categoria_fiscal c
              join erp_gen_pais p on p.pais_id = c.pais_id
             where c.estado = 'A'
             order by p.codigo, c.codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov departamentos (
    name: DEPARTAMENTOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select codigo || ' - ' || nombre d, departamento_id r
              from erp_gen_departamento
             where empresa_id = :APP_EMPRESA_ID
               and estado = 'A'
             order by codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

