authorization acceso-app (
    name: ACCESO_APP
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return adm_seg_seguridad_reg.tiene_acceso_app(:APP_USER, :APP_ID);
    }
    error {
        errorMessage: No tiene acceso a esta aplicación. Solicítelo al administrador.
    }
)

authorization es-superadmin (
    name: ES_SUPERADMIN
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return adm_seg_seguridad_reg.es_superadmin(:APP_USER);
    }
    error {
        errorMessage: No tiene permiso para realizar esta acción.
    }
)

authorization erp-gen-catalogo-gestionar (
    name: ERP_GEN_CATALOGO_GESTIONAR
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return adm_seg_seguridad_reg.tiene_permiso(:APP_USER, 'ERP_GEN_CATALOGO_GESTIONAR', :APP_EMPRESA_ID);
    }
    error {
        errorMessage: No tiene permiso para realizar esta acción en la empresa activa.
    }
)

