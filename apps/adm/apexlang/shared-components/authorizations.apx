authorization es-superadmin (
    name: ES_SUPERADMIN
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return adm_seguridad_reg.f_es_superadmin(:APP_USER);
    }
    error {
        errorMessage: No tiene permiso para realizar esta acción.
    }
)

authorization acceso-pagina (
    name: ACCESO_PAGINA
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody: return adm_seguridad_reg.f_tiene_acceso_pagina(:APP_USER, :APP_ID, :APP_PAGE_ID);
    }
    error {
        errorMessage: No tiene permiso para realizar esta acción.
    }
)

