lov estado-ai (
    name: ESTADO_AI
    source {
        location: staticValues
    }

    entry activo (
        sequence: 10
        display: Activo
        return: A
    )

    entry inactivo (
        sequence: 20
        display: Inactivo
        return: I
    )

)

