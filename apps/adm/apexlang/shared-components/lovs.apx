lov aplicaciones (
    name: APLICACIONES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select codigo || ' - ' || nombre d, aplicacion_id r
              from adm_seg_aplicacion
             order by orden, codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov modulos (
    name: MODULOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select a.codigo || ' / ' || m.codigo || ' - ' || m.nombre d, m.modulo_id r
              from adm_seg_modulo m
              join adm_seg_aplicacion a on a.aplicacion_id = m.aplicacion_id
             order by a.orden, a.codigo, m.orden, m.codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov permisos (
    name: PERMISOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select codigo || ' - ' || nombre d, permiso_id r
              from adm_seg_permiso
             order by codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov roles (
    name: ROLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select codigo || ' - ' || nombre d, rol_id r
              from adm_seg_rol
             order by codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov usuarios (
    name: USUARIOS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select username || ' - ' || nombres || ' ' || apellidos d, usuario_id r
              from adm_seg_usuario
             order by username
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov empresas (
