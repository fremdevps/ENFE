lov empresas (
    name: EMPRESAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select codigo || ' - ' || razon_social d, empresa_id r
              from adm_gen_empresa
             order by codigo
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov tablas-auditadas (
    name: TABLAS_AUDITADAS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select coalesce(regexp_replace(c.comments, '\.?\s*Abrev:.*$', null, 1, 1, 'i'), lower(t.table_name)) d,
                   t.table_name r
              from user_triggers t
              left join user_tab_comments c on c.table_name = t.table_name
             where t.trigger_name like 'TRG\_%\_AIUD' escape '\'
             order by 1
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

