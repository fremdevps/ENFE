        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 44
            }
        }
        userDefinedAttributes {
            1: Permisos atómicos por módulo.
        }
        security {
            authorizationScheme: @adm-seg-aplicacion-gestionar
        }
    )

    entry acc-empresas (
        label: Empresas
        icon {
            imageIconCssClasses: fa-building-o
        }
        layout {
            sequence: 60
        }
        link {
            target: {
                page: 50
            }
        }
        userDefinedAttributes {
            1: Empresas y unidades de negocio.
        }
        security {
            authorizationScheme: @adm-gen-empresa-gestionar
        }
    )

    entry acc-mensajes-error (
        label: Mensajes de error
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 70
        }
        link {
            target: {
                page: 52
            }
        }
        userDefinedAttributes {
            1: Textos claros para los errores de datos.
        }
        security {
            authorizationScheme: @adm-gen-mensaje-gestionar
        }
    )

    entry acc-bitacora-login (
        label: Bitácora de accesos
        icon {
            imageIconCssClasses: fa-history
        }
        layout {
            sequence: 80
        }
        link {
            target: {
                page: 60
            }
        }
        userDefinedAttributes {
            1: Quién ingresó, cuándo y con qué resultado.
        }
        security {
            authorizationScheme: @adm-aud-login-ver
        }
    )

    entry acc-bitacora-errores (
        label: Bitácora de errores
        icon {
            imageIconCssClasses: fa-bug
        }
        layout {
            sequence: 90
        }
        link {
            target: {
                page: 61
            }
        }
        userDefinedAttributes {
            1: Incidentes inesperados para soporte.
        }
        security {
            authorizationScheme: @adm-aud-error-ver
        }
    )

)
