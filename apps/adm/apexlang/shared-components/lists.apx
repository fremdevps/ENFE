list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry cambiar-password (
        label: Cambiar contraseña
        icon {
            imageIconCssClasses: fa-key
        }
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                page: 90
            }
        }
    )

    entry --- (
        label: ---
        layout {
            sequence: 25
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry sign-out (
        label: Cerrar sesión
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry inicio (
        label: Inicio
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry seguridad (
        label: Seguridad
        icon {
            imageIconCssClasses: fa-shield
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry usuarios (
        label: Usuarios
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 21
            parentEntry: @seguridad
        }
        link {
            target: {
                page: 30
            }
        }
        security {
            authorizationScheme: @adm-seg-usuario-ver
        }
    )

    entry roles (
        label: Roles y permisos
        icon {
            imageIconCssClasses: fa-key
        }
        layout {
            sequence: 22
            parentEntry: @seguridad
        }
        link {
            target: {
                page: 20
            }
        }
        security {
            authorizationScheme: @adm-seg-rol-gestionar
        }
    )

    entry catalogo (
        label: Catálogo
        icon {
            imageIconCssClasses: fa-sitemap
        }
        layout {
            sequence: 32
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry aplicaciones (
        label: Aplicaciones
        icon {
            imageIconCssClasses: fa-apps
        }
        layout {
            sequence: 33
            parentEntry: @catalogo
        }
        link {
            target: {
                page: 40
            }
        }
        security {
            authorizationScheme: @adm-seg-aplicacion-gestionar
        }
    )

    entry modulos (
        label: Módulos
        icon {
            imageIconCssClasses: fa-folder-o
        }
        layout {
            sequence: 34
            parentEntry: @catalogo
        }
        link {
            target: {
                page: 42
            }
        }
        security {
            authorizationScheme: @adm-seg-aplicacion-gestionar
        }
    )

    entry permisos (
        label: Permisos
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 35
            parentEntry: @catalogo
        }
        link {
            target: {
                page: 44
            }
        }
        security {
            authorizationScheme: @adm-seg-aplicacion-gestionar
        }
    )

    entry empresas (
        label: Empresas
        icon {
            imageIconCssClasses: fa-building-o
        }
        layout {
            sequence: 36
            parentEntry: @catalogo
        }
        link {
            target: {
                page: 50
            }
        }
        security {
            authorizationScheme: @adm-gen-empresa-gestionar
        }
    )

    entry mensajes-error (
        label: Mensajes de error
        icon {
            imageIconCssClasses: fa-comment-o
        }
        layout {
            sequence: 37
            parentEntry: @catalogo
        }
        link {
            target: {
                page: 52
            }
        }
        security {
            authorizationScheme: @adm-gen-mensaje-gestionar
        }
    )

    entry auditoria (
        label: Auditoría
        icon {
            imageIconCssClasses: fa-search
        }
        layout {
            sequence: 47
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry bitacora-login (
        label: Bitácora de accesos
        icon {
            imageIconCssClasses: fa-history
        }
        layout {
            sequence: 48
            parentEntry: @auditoria
        }
        link {
            target: {
                page: 60
            }
        }
        security {
            authorizationScheme: @adm-aud-login-ver
        }
    )

    entry bitacora-errores (
        label: Bitácora de errores
        icon {
            imageIconCssClasses: fa-bug
        }
        layout {
            sequence: 49
            parentEntry: @auditoria
        }
        link {
            target: {
                page: 61
            }
        }
        security {
            authorizationScheme: @adm-aud-error-ver
        }
    )

)

list accesos (
    name: Accesos

    entry acc-usuarios (
        label: Usuarios
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 30
            }
        }
        userDefinedAttributes {
            1: Alta, edición, roles y contraseñas de los usuarios.
        }
        security {
            authorizationScheme: @adm-seg-usuario-ver
        }
    )

    entry acc-roles (
        label: Roles y permisos
        icon {
            imageIconCssClasses: fa-key
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 20
            }
        }
        userDefinedAttributes {
            1: Qué puede hacer cada rol en cada aplicación.
        }
        security {
            authorizationScheme: @adm-seg-rol-gestionar
        }
    )

    entry acc-aplicaciones (
        label: Aplicaciones
        icon {
            imageIconCssClasses: fa-apps
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 40
            }
        }
