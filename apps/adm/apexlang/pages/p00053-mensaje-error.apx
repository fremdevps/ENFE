page 53 (
    name: Mensaje de error
    alias: MENSAJE-ERROR
    title: Mensaje de error
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @adm-gen-mensaje-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición: mensaje de error.
            Los campos marcados son obligatorios.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Mensaje de error
        type: form
        source {
            location: localDatabase
            tableName: ADM_GEN_MENSAJE_ERROR
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P53_MENSAJE_ERROR_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: MENSAJE_ERROR_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P53_CODIGO (
        type: textField
        label {
            label: Constraint
        }
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: CODIGO
            dataType: varchar2
        }
        help {
            inlineHelpText: En mayúsculas, ej. UK_ADM_USU_USERNAME
            helpText: Nombre exacto del constraint de la base de datos.
        }
    )

    pageItem P53_MENSAJE (
        type: textarea
        label {
            label: Mensaje para el usuario
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: MENSAJE
            dataType: varchar2
        }
        help {
            inlineHelpText: Claro y sin términos técnicos
            helpText: Texto que verá el usuario cuando un dato viole esa regla.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button eliminar (
        buttonName: ELIMINAR
        label: Eliminar
        layout {
            sequence: 20
            region: @botones
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar este registro?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P53_MENSAJE_ERROR_ID
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P53_MENSAJE_ERROR_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P53_MENSAJE_ERROR_ID
        }
    )

    region historial (
        name: Historial
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(h.fecha, 'DD/MM/YYYY HH24:MI') fecha,
                       h.usuario,
                       h.operacion_desc || ' - ' || h.entidad cambio,
                       h.campo,
                       h.antes,
                       h.despues
                  from (select d.*
                          from adm_aud_cambio_det_v d
                         where d.tabla = 'ADM_GEN_MENSAJE_ERROR'
                           and d.registro_id = :P53_MENSAJE_ERROR_ID) h
                 order by h.fecha desc, h.cambio_id desc, h.orden
                ```
        }
        layout {
            sequence: 90
            slot: contentBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
        advanced {
            htmlDomId: historial
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Este registro todavía no tiene cambios registrados.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P53_MENSAJE_ERROR_ID
        }
        security {
            authorizationScheme: @adm-aud-cambio-ver
        }
        comments {
            comments: Historial de cambios del registro (vista adm_aud_cambio_det_v), solo lectura.
        }

        column FECHA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Fecha
                alignment: start
            }
            layout {
                sequence: 10
                columnAlignment: start
            }
        )

        column USUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
        )

        column CAMBIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Cambio
                alignment: start
            }
            layout {
                sequence: 30
                columnAlignment: start
            }
        )

        column CAMPO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Campo
                alignment: start
            }
            layout {
                sequence: 40
                columnAlignment: start
            }
        )

        column ANTES (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Antes
                alignment: start
            }
            layout {
                sequence: 50
                columnAlignment: start
            }
        )

        column DESPUES (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Después
                alignment: start
            }
            layout {
                sequence: 60
                columnAlignment: start
            }
        )
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Mensaje de error
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process guardar-datos (
        name: Guardar Mensaje de error
        type: formAutoRowProcessing
        formRegion: @formulario
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
