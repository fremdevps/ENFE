page 40 (
    name: Aplicaciones
    alias: APLICACIONES
    title: Aplicaciones
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @adm-seg-aplicacion-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Catálogo de aplicaciones controladas por la seguridad central.
            Use Crear aplicación para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Aplicaciones
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region aplicaciones (
        name: Aplicaciones
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aplicacion_id, codigo, nombre, apex_app_id, orden,
                       decode(estado, 'A', 'Activo', 'Inactivo') estado
                  from adm_seg_aplicacion
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: aplicaciones
        }
        link {
            linkColumn: customTarget
            target: {
                page: 41
                items: {
                    P41_APLICACION_ID: #APLICACION_ID#
                }
                clearCache: 41
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de adm_seg_aplicacion. Alta/edición en la página 41 (guardado automático: catálogo simple).
                ```
        }

        column APLICACION_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: Prefijo de los objetos de la app. Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column APEX_APP_ID (
            type: plainText
            heading {
                heading: ID App APEX
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: ID App APEX. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ORDEN (
            type: plainText
            heading {
                heading: Orden
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Orden. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear aplicación
        layout {
            sequence: 10
            region: @aplicaciones
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 41
                clearCache: 41
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @aplicaciones
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @aplicaciones
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
