page 40 (
    name: Aplicaciones
    alias: APLICACIONES
    title: Aplicaciones
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-seg-aplicacion-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Catálogo de aplicaciones controladas por la seguridad central.
            Registre aquí cada app APEX nueva con su ID fijo; sus módulos y permisos se definen en las páginas siguientes.
            ```
    }

    region aplicaciones (
        name: Aplicaciones
        type: interactiveGrid
        advanced {
            htmlDomId: aplicaciones
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select aplicacion_id, codigo, nombre, descripcion, apex_app_id, icono, orden, estado
                  from adm_seg_aplicacion
                ```
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }
        comments {
            comments:
                ```
                Mantenimiento de adm_seg_aplicacion.
                ```
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column APLICACION_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: APLICACION_ID
                dataType: number
                primaryKey: true
            }
        )

        column CODIGO (
            type: textField
            heading {
                heading: Código
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CODIGO
                dataType: varchar2
            }
            comments {
                comments: Summary: Prefijo de todos los objetos de la app (adm, erp…). Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: textField
            heading {
                heading: Nombre
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: NOMBRE
                dataType: varchar2
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: Descripción
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            comments {
                comments: Display Label: Descripción. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column APEX_APP_ID (
            type: numberField
            heading {
                heading: ID App APEX
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: APEX_APP_ID
                dataType: number
            }
            comments {
                comments: Summary: Bloques de 100: ADM 100, ERP 200. Display Label: ID App APEX. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ICONO (
            type: textField
            heading {
                heading: Icono
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ICONO
                dataType: varchar2
            }
            comments {
                comments: Display Label: Icono. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ORDEN (
            type: numberField
            heading {
                heading: Orden
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ORDEN
                dataType: number
            }
            comments {
                comments: Display Label: Orden. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: selectList
            heading {
                heading: Estado
            }
            layout {
                sequence: 100
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @estado-ai
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    process aplicaciones-guardar (
        name: Guardar Aplicaciones
        type: interactiveGridAutoRowProcessing
        editableRegion: @aplicaciones
        execution {
            sequence: 10
        }
    )
)
