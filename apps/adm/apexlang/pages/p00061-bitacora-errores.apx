page 61 (
    name: Bitácora de errores
    alias: BITACORA-ERRORES
    title: Bitácora de errores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @adm-aud-error-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Incidentes inesperados registrados por el manejador de errores.
            Busque por el número de incidente que le informó el usuario.
            ```
    }

    region breadcrumb (
        name: Bitácora de errores
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region bitacora-errores (
        name: Bitácora de errores
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.error_id, e.error_id incidente, e.fecha, coalesce(a.nombre, to_char(e.apex_app_id)) aplicacion,
                       e.apex_pagina_id pagina, e.username, e.componente, e.mensaje, e.ora_sqlerrm
                  from adm_aud_error e
                  left join adm_seg_aplicacion a on a.apex_app_id = e.apex_app_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: bitacora-errores
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Consulta de adm_aud_error (solo lectura). Incidente = error_id.
                ```
        }

        column ERROR_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column INCIDENTE (
            type: plainText
            heading {
                heading: Incidente
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Summary: Número que ve el usuario en el mensaje de error. Display Label: Incidente. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column FECHA (
            type: plainText
            heading {
                heading: Fecha
            }
            layout {
                sequence: 30
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Fecha. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column APLICACION (
            type: plainText
            heading {
                heading: Aplicación
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Aplicación. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column PAGINA (
            type: plainText
            heading {
                heading: Página
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Página. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Usuario
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Usuario. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column COMPONENTE (
            type: plainText
            heading {
                heading: Componente
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Componente. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column MENSAJE (
            type: plainText
            heading {
                heading: Mensaje
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Mensaje. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ORA_SQLERRM (
            type: plainText
            heading {
                heading: Detalle técnico
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Detalle técnico. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )
)
