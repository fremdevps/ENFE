page 61 (
    name: Bitácora de errores
    alias: BITACORA-ERRORES
    title: Bitácora de errores
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-aud-error-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Incidentes inesperados registrados por el manejador de errores.
            El usuario ve solo el número de incidente: búsquelo aquí por su código (columna oculta ERROR_ID, use la búsqueda).
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region bitacora-errores (
        name: Bitácora de errores
        type: interactiveGrid
        advanced {
            htmlDomId: bitacora-errores
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select error_id, to_char(fecha, 'DD/MM/YYYY HH24:MI:SS') fecha_hora, apex_app_id, apex_pagina_id,
                       username, componente, mensaje, ora_sqlcode, ora_sqlerrm
                  from adm_aud_error
                 order by error_id desc
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }
        comments {
            comments:
                ```
                Consulta de adm_aud_error (solo lectura). El número de incidente = error_id.
                ```
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column ERROR_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ERROR_ID
                dataType: number
                primaryKey: true
            }
        )

        column FECHA_HORA (
            type: textField
            heading {
                heading: Fecha
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: FECHA_HORA
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Fecha. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column APEX_APP_ID (
            type: numberField
            heading {
                heading: App
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: APEX_APP_ID
                dataType: number
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: App. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

