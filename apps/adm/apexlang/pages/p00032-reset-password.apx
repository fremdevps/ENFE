page 32 (
    name: Resetear contraseña
    alias: RESET-PASSWORD
    title: Resetear contraseña
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @adm-seg-usuario-reset-password
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Asigne una contraseña temporal al usuario.
            Queda desbloqueado y deberá cambiarla en su próximo ingreso.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region datos (
        name: Resetear contraseña
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P32_USUARIO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @datos
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P32_PASSWORD (
        type: password
        label {
            label: Nueva contraseña temporal
        }
        layout {
            sequence: 20
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Mín. 8, letras y números
            helpText: Comuníquela al usuario por un canal seguro.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 5
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button resetear (
        buttonName: RESETEAR
        label: Resetear contraseña
        layout {
            sequence: 10
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process resetear-proceso (
        name: Resetear
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                adm_seg_usuario_api.resetear_password(
                    i_usuario_id     => :P32_USUARIO_ID,
                    i_password_nuevo => :P32_PASSWORD);
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @resetear
        }
        successMessage {
            successMessage: Contraseña reseteada y usuario desbloqueado.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: RESETEAR
        }
    )
)
