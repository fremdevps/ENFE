page 32 (
    name: Resetear contraseña
    alias: RESET-PASSWORD
    title: Resetear contraseña
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        authorizationScheme: @adm-seg-usuario-reset-password
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region datos (
        name: Resetear contraseña
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P32_USUARIO_ID (
        type: selectList
        label {
            label: Usuario
        }
        layout {
            sequence: 10
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }        lov {
            type: sharedComponent
            lov: @usuarios
        }
    )

    pageItem P32_PASSWORD (
        type: password
        label {
            label: Nueva contraseña temporal
        }
        layout {
            sequence: 20
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    button resetear (
        buttonName: RESETEAR
        label: Resetear contraseña
        layout {
            sequence: 10
            region: @datos
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    process resetear-password (
        name: Resetear contraseña
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    adm_usuario_ctr.P_CAMBIAR_PASSWORD(
                        I_USUARIO_ID     => :P32_USUARIO_ID,
                        I_PASSWORD_NUEVO => :P32_PASSWORD,
                        I_DEBE_CAMBIAR   => 'S');
                    adm_usuario_ctr.P_DESBLOQUEAR(I_USUARIO_ID => :P32_USUARIO_ID);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @resetear
        }
        successMessage {
            successMessage: Contraseña reseteada y usuario desbloqueado.
        }
    )

    branch ir-a-30 (
        name: Ir a página 30
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 30
            }
        }
    )
)
