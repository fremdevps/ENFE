page 32 (
    name: Resetear contraseña
    alias: RESET-PASSWORD
    title: Resetear contraseña
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        authorizationScheme: @adm-seg-usuario-reset-password
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Asigne una contraseña temporal a un usuario local.
            El usuario queda desbloqueado y deberá cambiarla al ingresar.
            ```
    }

    region datos (
        name: Resetear contraseña
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P32_USUARIO_ID (
        type: selectList
        label {
            label: Usuario
        }
        layout {
            sequence: 10
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @usuarios
        }
        help {
            inlineHelpText: Usuario local
            helpText: Usuario al que se le asignará la contraseña temporal.
        }
    )

    pageItem P32_PASSWORD (
        type: password
        label {
            label: Nueva contraseña temporal
        }
        layout {
            sequence: 20
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Mín. 8, letras y números
            helpText: Comuníquela al usuario por un canal seguro.
        }
    )

    button resetear (
        buttonName: RESETEAR
        label: Resetear contraseña
        layout {
            sequence: 10
            region: @datos
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    process resetear-proceso (
        name: Resetear contraseña
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    adm_seg_usuario_api.resetear_password(
                        i_usuario_id     => :P32_USUARIO_ID,
                        i_password_nuevo => :P32_PASSWORD);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @resetear
        }
        successMessage {
            successMessage: Contraseña reseteada y usuario desbloqueado.
        }
    )

    branch ir-a-30 (
        name: Ir a página 30
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 30
            }
        }
    )
)
