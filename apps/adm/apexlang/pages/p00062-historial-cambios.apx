page 62 (
    name: Historial de cambios
    alias: HISTORIAL-CAMBIOS
    title: Historial de cambios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @adm-aud-cambio-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Quién cambió qué dato y cuándo, en todas las aplicaciones.
            Filtre por dato, usuario, operación, empresa o fechas y use la lupa de cada fila para ver el valor anterior y el nuevo de cada campo.
            ```
    }

    region breadcrumb (
        name: Historial de cambios
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 15
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P62_TABLA (
        type: selectList
        label {
            label: Dato
        }
        layout {
            sequence: 10
            region: @filtros
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @tablas-auditadas
            displayNullValue: true
            nullDisplayValue: - Todos -
        }
        help {
            helpText: Tabla cuyo historial quiere ver.
        }
    )

    pageItem P62_USUARIO (
        type: textField
        label {
            label: Usuario
        }
        layout {
            sequence: 20
            region: @filtros
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Nombre de usuario exacto de quien hizo el cambio.
        }
    )

    pageItem P62_OPERACION (
        type: selectList
        label {
            label: Operación
        }
        layout {
            sequence: 30
            region: @filtros
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @operacion-cambio
            displayNullValue: true
            nullDisplayValue: - Todas -
        }
        help {
            helpText: Alta, modificación o eliminación.
        }
    )

    pageItem P62_EMPRESA_ID (
        type: selectList
        label {
            label: Empresa
        }
        layout {
            sequence: 40
            region: @filtros
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @empresas
            displayNullValue: true
            nullDisplayValue: - Todas -
        }
        help {
            helpText: Empresa del registro modificado.
        }
    )

    pageItem P62_DESDE (
        type: datePicker
        label {
            label: Desde
        }
        layout {
            sequence: 50
            region: @filtros
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Fecha inicial (inclusive).
        }
    )

    pageItem P62_HASTA (
        type: datePicker
        label {
            label: Hasta
        }
        layout {
            sequence: 60
            region: @filtros
            slot: regionBody
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Fecha final (inclusive).
        }
    )

    button buscar (
        buttonName: BUSCAR
        label: Buscar
        layout {
            sequence: 20
            region: @filtros
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-search
        }
    )

    button limpiar (
        buttonName: LIMPIAR
        label: Limpiar filtros
        layout {
            sequence: 10
            region: @filtros
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 62
                clearCache: 62
            }
        }
    )

    region historial-cambios (
        name: Historial de cambios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.cambio_id, h.fecha, h.usuario, h.app_codigo aplicacion, h.entidad, h.registro_id,
                       h.operacion_desc operacion, h.campos, h.empresa, h.apex_pagina_id pagina, h.tabla
                  from adm_aud_cambio_v h
                 where (:P62_TABLA is null or h.tabla = :P62_TABLA)
                   and (:P62_USUARIO is null or h.usuario = upper(:P62_USUARIO))
                   and (:P62_OPERACION is null or h.operacion = :P62_OPERACION)
                   and (:P62_EMPRESA_ID is null or h.empresa_id = to_number(:P62_EMPRESA_ID))
                   and (:P62_DESDE is null or h.fecha >= to_date(:P62_DESDE))
                   and (:P62_HASTA is null or h.fecha < to_date(:P62_HASTA) + 1)
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: historial-cambios
        }
        link {
            linkColumn: customTarget
            target: {
                page: 63
                items: {
                    P63_CAMBIO_ID: #CAMBIO_ID#
                }
                clearCache: 63
            }
            linkIcon: <span role="img" aria-label="Ver detalle" class="fa fa-search" title="Ver detalle"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Consulta de adm_aud_cambio (vista adm_aud_cambio_v), solo lectura. Detalle en el modal Detalle del cambio.
                ```
        }

        column CAMBIO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column FECHA (
            type: plainText
            heading {
                heading: Fecha
            }
            layout {
                sequence: 20
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Fecha. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column USUARIO (
            type: plainText
            heading {
                heading: Usuario
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Usuario. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column APLICACION (
            type: plainText
            heading {
                heading: Aplicación
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Aplicación. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ENTIDAD (
            type: plainText
            heading {
                heading: Dato
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: Tabla modificada (su descripción). Display Label: Dato. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column REGISTRO_ID (
            type: plainText
            heading {
                heading: ID del registro
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: ID del registro. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column OPERACION (
            type: plainText
            heading {
                heading: Operación
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: Alta, Modificación o Eliminación. Display Label: Operación. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column CAMPOS (
            type: plainText
            heading {
                heading: Campos
            }
            layout {
                sequence: 80
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Summary: Cantidad de campos que cambiaron. Display Label: Campos. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Empresa. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column PAGINA (
            type: plainText
            heading {
                heading: Página
            }
            layout {
                sequence: 100
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Summary: Página APEX desde la que se hizo el cambio. Display Label: Página. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column TABLA (
            type: plainText
            heading {
                heading: Tabla
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Tabla. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )
)
