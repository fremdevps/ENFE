page 52 (
    name: Mensajes de error
    alias: MENSAJES-ERROR
    title: Mensajes de error
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @adm-gen-mensaje-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Mensajes claros que ve el usuario cuando un dato viola una regla de la base de datos. Aplica a todas las aplicaciones.
            Use Crear mensaje para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Mensajes de error
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region mensajes-error (
        name: Mensajes de error
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select mensaje_error_id, codigo, mensaje
                  from adm_gen_mensaje_error
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: mensajes-error
        }
        link {
            linkColumn: customTarget
            target: {
                page: 53
                items: {
                    P53_MENSAJE_ERROR_ID: #MENSAJE_ERROR_ID#
                }
                clearCache: 53
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de adm_gen_mensaje_error. Alta/edición en la página 53 (guardado automático: catálogo simple).
                ```
        }

        column MENSAJE_ERROR_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Constraint
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: Nombre exacto del constraint. Display Label: Constraint. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column MENSAJE (
            type: plainText
            heading {
                heading: Mensaje para el usuario
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Mensaje para el usuario. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear mensaje
        layout {
            sequence: 10
            region: @mensajes-error
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 53
                clearCache: 53
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @mensajes-error
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @mensajes-error
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
