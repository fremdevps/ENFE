page 60 (
    name: Bitácora de accesos
    alias: BITACORA-LOGIN
    title: Bitácora de accesos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-aud-login-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region bitacora-login (
        name: Bitácora de accesos
        type: interactiveGrid
        advanced {
            htmlDomId: bitacora-login
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select login_id, username, resultado, apex_app_id, ip_cliente,
                       to_char(fecha, 'DD/MM/YYYY HH24:MI:SS') fecha_hora
                  from adm_aud_login
                 order by fecha desc
                ```
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column LOGIN_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LOGIN_ID
                dataType: number
                primaryKey: true
            }
        )

        column FECHA_HORA (
            type: textField
            heading {
                heading: Fecha
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: FECHA_HORA
                dataType: varchar2
            }
        )

        column USERNAME (
            type: textField
            heading {
                heading: Usuario
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: USERNAME
                dataType: varchar2
            }
        )

        column RESULTADO (
            type: textField
            heading {
                heading: Resultado
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: RESULTADO
                dataType: varchar2
            }
        )

        column APEX_APP_ID (
            type: numberField
            heading {
                heading: App
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: APEX_APP_ID
                dataType: number
            }
        )

        column IP_CLIENTE (
            type: textField
            heading {
                heading: IP
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IP_CLIENTE
                dataType: varchar2
            }
        )
    )
)
