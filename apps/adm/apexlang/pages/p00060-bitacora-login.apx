page 60 (
    name: Bitácora de accesos
    alias: BITACORA-LOGIN
    title: Bitácora de accesos
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @adm-aud-login-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Historial de inicios de sesión de todas las aplicaciones.
            Filtre por usuario o resultado para investigar bloqueos o accesos denegados.
            ```
    }

    region breadcrumb (
        name: Bitácora de accesos
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region bitacora-login (
        name: Bitácora de accesos
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.login_id, l.fecha, l.username, initcap(replace(l.resultado, '_', ' ')) resultado,
                       coalesce(a.nombre, to_char(l.apex_app_id)) aplicacion, l.ip_cliente
                  from adm_aud_login l
                  left join adm_seg_aplicacion a on a.apex_app_id = l.apex_app_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: bitacora-login
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Consulta de adm_aud_login (solo lectura).
                ```
        }

        column LOGIN_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column FECHA (
            type: plainText
            heading {
                heading: Fecha
            }
            layout {
                sequence: 20
            }
            source {
                dataType: DATE
            }
            comments {
                comments: Display Label: Fecha. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Usuario
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Usuario. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column RESULTADO (
            type: plainText
            heading {
                heading: Resultado
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: Ok, Password Invalido, Bloqueado, Sin Acceso… Display Label: Resultado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column APLICACION (
            type: plainText
            heading {
                heading: Aplicación
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Aplicación. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column IP_CLIENTE (
            type: plainText
            heading {
                heading: IP
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: IP. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )
)
