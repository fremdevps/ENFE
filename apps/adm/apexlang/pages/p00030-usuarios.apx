page 30 (
    name: Usuarios
    alias: USUARIOS
    title: Usuarios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-seg-usuario-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Consulte y edite los usuarios de todas las aplicaciones.
            Para crear usuarios use Nuevo usuario; para contraseñas, Resetear contraseña. Cambiar el estado de Bloqueado a Activo desbloquea al usuario.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region usuarios (
        name: Usuarios
        type: interactiveGrid
        advanced {
            htmlDomId: usuarios
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select usuario_id, username, email, nombres, apellidos, tipo_autenticacion,
                       empresa_id_defecto, estado, intentos_fallidos, debe_cambiar_password
                  from adm_seg_usuario
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }
        comments {
            comments:
                ```
                Edición de adm_seg_usuario (solo update). El alta y la contraseña van por adm_seg_usuario_api.
                ```
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column USUARIO_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: USUARIO_ID
                dataType: number
                primaryKey: true
            }
        )

        column USERNAME (
            type: textField
            heading {
                heading: Usuario
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: USERNAME
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Usuario. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column EMAIL (
            type: textField
            heading {
                heading: Email
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: EMAIL
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Email. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRES (
            type: textField
            heading {
                heading: Nombres
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: NOMBRES
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Nombres. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column APELLIDOS (
            type: textField
            heading {
                heading: Apellidos
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: APELLIDOS
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Apellidos. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column TIPO_AUTENTICACION (
            type: selectList
            heading {
                heading: Autenticación
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: TIPO_AUTENTICACION
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @tipo-autenticacion
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Autenticación. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column EMPRESA_ID_DEFECTO (
            type: selectList
            heading {
                heading: Empresa por defecto
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: EMPRESA_ID_DEFECTO
                dataType: number
            }
            lov {
                type: sharedComponent
                lov: @empresas
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Empresa por defecto. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: selectList
            heading {
                heading: Estado
            }
            layout {
                sequence: 100
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @estado-usuario
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Summary: Pasar de Bloqueado a Activo reinicia los intentos. Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column INTENTOS_FALLIDOS (
            type: numberField
            heading {
                heading: Intentos fallidos
            }
            layout {
                sequence: 110
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: INTENTOS_FALLIDOS
                dataType: number
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Intentos fallidos. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DEBE_CAMBIAR_PASSWORD (
            type: selectList
            heading {
                heading: Debe cambiar contraseña
            }
            layout {
                sequence: 120
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: DEBE_CAMBIAR_PASSWORD
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @si-no
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Debe cambiar contraseña. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    process usuarios-guardar (
        name: Guardar Usuarios
        type: interactiveGridAutoRowProcessing
        editableRegion: @usuarios
        execution {
            sequence: 10
        }
    )
)
