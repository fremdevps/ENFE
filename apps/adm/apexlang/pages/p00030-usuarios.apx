page 30 (
    name: Usuarios
    alias: USUARIOS
    title: Usuarios
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @adm-seg-usuario-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Usuarios de todas las aplicaciones.
            Use Crear usuario para dar de alta o el lápiz para editar, asignar roles o resetear la contraseña.
            ```
    }

    region breadcrumb (
        name: Usuarios
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region usuarios (
        name: Usuarios
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.usuario_id, u.username, u.nombres || ' ' || u.apellidos nombre, u.email,
                       decode(u.tipo_autenticacion, 'LOCAL', 'Local', 'SSO') autenticacion,
                       e.razon_social empresa,
                       decode(u.estado, 'A', 'Activo', 'I', 'Inactivo', 'B', 'Bloqueado', u.estado) estado,
                       to_char(u.fecha_ultimo_login, 'DD/MM/YYYY HH24:MI') ultimo_ingreso
                  from adm_seg_usuario u
                  left join adm_gen_empresa e on e.empresa_id = u.empresa_id_defecto
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: usuarios
        }
        link {
            linkColumn: customTarget
            target: {
                page: 31
                items: {
                    P31_USUARIO_ID: #USUARIO_ID#
                }
                clearCache: 31
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de adm_seg_usuario. Alta/edición en la página 31 vía adm_seg_usuario_api.
                ```
        }

        column USUARIO_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Usuario
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Usuario. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Email. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column AUTENTICACION (
            type: plainText
            heading {
                heading: Autenticación
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Autenticación. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column EMPRESA (
            type: plainText
            heading {
                heading: Empresa por defecto
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Empresa por defecto. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Summary: Bloqueado = superó los intentos fallidos. Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ULTIMO_INGRESO (
            type: plainText
            heading {
                heading: Último ingreso
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Último ingreso. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear usuario
        layout {
            sequence: 10
            region: @usuarios
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 31
                clearCache: 31
            }
        }
        security {
            authorizationScheme: @adm-seg-usuario-gestionar
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @usuarios
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @usuarios
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
