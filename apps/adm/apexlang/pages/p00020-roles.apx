page 20 (
    name: Roles
    alias: ROLES
    title: Roles
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-seg-rol-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Defina los roles de cada aplicación o roles globales.
            Un rol agrupa permisos; luego se asigna a usuarios en Roles por usuario. Use Superadmin solo para administradores técnicos.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region roles (
        name: Roles
        type: interactiveGrid
        advanced {
            htmlDomId: roles
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rol_id, aplicacion_id, codigo, nombre, descripcion, es_superadmin, estado
                  from adm_seg_rol
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }
        comments {
            comments:
                ```
                Mantenimiento de adm_seg_rol (DML automático del IG). Mensajes de constraint: adm_gen_mensaje_error.
                ```
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column ROL_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROL_ID
                dataType: number
                primaryKey: true
            }
        )

        column CODIGO (
            type: textField
            heading {
                heading: Código
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CODIGO
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Summary: Código único <APP>_<NOMBRE> en mayúsculas. Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column APLICACION_ID (
            type: selectList
            heading {
                heading: Aplicación (vacío = global)
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: APLICACION_ID
                dataType: number
            }
            lov {
                type: sharedComponent
                lov: @aplicaciones
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Summary: Null = rol global. Display Label: Aplicación (vacío = global). Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: textField
            heading {
                heading: Nombre
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: NOMBRE
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: Descripción
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Descripción. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ES_SUPERADMIN (
            type: selectList
            heading {
                heading: Superadmin
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ES_SUPERADMIN
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @si-no
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Summary: S otorga todos los permisos de todas las apps. Display Label: Superadmin. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: selectList
            heading {
                heading: Estado
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @estado-ai
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    process roles-guardar (
        name: Guardar Roles
        type: interactiveGridAutoRowProcessing
        editableRegion: @roles
        execution {
            sequence: 10
        }
    )
)
