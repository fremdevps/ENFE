page 20 (
    name: Roles
    alias: ROLES
    title: Roles
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-seg-rol-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region roles (
        name: Roles
        type: interactiveGrid
        advanced {
            htmlDomId: roles
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rol_id, aplicacion_id, codigo, nombre, descripcion, es_superadmin, estado
                  from adm_seg_rol
                ```
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column ROL_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROL_ID
                dataType: number
                primaryKey: true
            }
        )

        column APLICACION_ID (
            type: selectList
            heading {
                heading: Aplicación (vacío = global)
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: APLICACION_ID
                dataType: number
            }
            lov {
                type: sharedComponent
                lov: @aplicaciones
            }
        )

        column CODIGO (
            type: textField
            heading {
                heading: Código
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CODIGO
                dataType: varchar2
            }
        )

        column NOMBRE (
            type: textField
            heading {
                heading: Nombre
            }
            layout {
                sequence: 60
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: NOMBRE
                dataType: varchar2
            }
        )

        column DESCRIPCION (
            type: textField
            heading {
                heading: Descripción
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: DESCRIPCION
                dataType: varchar2
            }
        )

        column ES_SUPERADMIN (
            type: selectList
            heading {
                heading: Superadmin
            }
            layout {
                sequence: 80
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ES_SUPERADMIN
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @si-no
            }
        )

        column ESTADO (
            type: selectList
            heading {
                heading: Estado
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @estado-ai
            }
        )
    )

    process roles-guardar (
        name: Guardar Roles
        type: interactiveGridAutoRowProcessing
        editableRegion: @roles
        execution {
            sequence: 10
        }
    )
)
