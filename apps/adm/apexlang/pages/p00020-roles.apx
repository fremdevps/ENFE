page 20 (
    name: Roles
    alias: ROLES
    title: Roles
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @adm-seg-rol-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Roles de cada aplicación o globales.
            Un rol agrupa permisos; ábralo para elegir sus permisos.
            ```
    }

    region breadcrumb (
        name: Roles
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region roles (
        name: Roles
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.rol_id, r.codigo, r.nombre, coalesce(a.nombre, 'Global') aplicacion,
                       decode(r.es_superadmin, 'S', 'Sí', 'No') superadmin,
                       (select count(*) from adm_seg_rol_permiso rp where rp.rol_id = r.rol_id) permisos,
                       (select count(*) from adm_seg_usuario_rol ur where ur.rol_id = r.rol_id) usuarios,
                       decode(r.estado, 'A', 'Activo', 'Inactivo') estado
                  from adm_seg_rol r
                  left join adm_seg_aplicacion a on a.aplicacion_id = r.aplicacion_id
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: roles
        }
        link {
            linkColumn: customTarget
            target: {
                page: 21
                items: {
                    P21_ROL_ID: #ROL_ID#
                }
                clearCache: 21
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de adm_seg_rol. Alta/edición en la página 21 vía adm_seg_rol_api.
                ```
        }

        column ROL_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE (
            type: plainText
            heading {
                heading: Nombre
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nombre. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column APLICACION (
            type: plainText
            heading {
                heading: Aplicación
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Aplicación. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column SUPERADMIN (
            type: plainText
            heading {
                heading: Superadmin
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Superadmin. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column PERMISOS (
            type: plainText
            heading {
                heading: Permisos
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Permisos. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column USUARIOS (
            type: plainText
            heading {
                heading: Usuarios
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            comments {
                comments: Display Label: Usuarios. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear rol
        layout {
            sequence: 10
            region: @roles
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
                clearCache: 21
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @roles
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @roles
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
