page 31 (
    name: Nuevo usuario
    alias: NUEVO-USUARIO
    title: Nuevo usuario
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        authorizationScheme: @adm-seg-usuario-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Cree un usuario para cualquiera de las aplicaciones.
            Los usuarios locales reciben una contraseña inicial que deberán cambiar en su primer ingreso. Después asígnele roles en Roles por usuario.
            ```
    }

    region datos (
        name: Nuevo usuario
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P31_USERNAME (
        type: textField
        label {
            label: Usuario
        }
        layout {
            sequence: 10
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Se guarda en mayúsculas
            helpText: Nombre con el que iniciará sesión. Debe ser único.
        }
    )

    pageItem P31_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 20
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Correo único
            helpText: Correo electrónico de contacto; no puede repetirse.
        }
    )

    pageItem P31_NOMBRES (
        type: textField
        label {
            label: Nombres
        }
        layout {
            sequence: 30
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Nombres de la persona
            helpText: Nombres tal como se mostrarán en las aplicaciones.
        }
    )

    pageItem P31_APELLIDOS (
        type: textField
        label {
            label: Apellidos
        }
        layout {
            sequence: 40
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            inlineHelpText: Apellidos (opcional)
            helpText: Apellidos de la persona.
        }
    )

    pageItem P31_TIPO_AUTENTICACION (
        type: selectList
        label {
            label: Autenticación
        }
        layout {
            sequence: 50
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipo-autenticacion
        }
        help {
            inlineHelpText: Local o SSO
            helpText: Local: usa contraseña propia. SSO: se autentica con un proveedor externo.
        }
    )

    pageItem P31_PASSWORD (
        type: password
        label {
            label: Contraseña inicial (solo LOCAL)
        }
        layout {
            sequence: 60
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            inlineHelpText: Mín. 8, letras y números
            helpText: Contraseña temporal; el sistema obligará a cambiarla en el primer ingreso.
        }
    )

    pageItem P31_EMPRESA_ID (
        type: selectList
        label {
            label: Empresa por defecto
        }
        layout {
            sequence: 70
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @empresas
        }
        help {
            inlineHelpText: Empresa habitual
            helpText: Empresa con la que el usuario trabaja por defecto.
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear usuario
        layout {
            sequence: 10
            region: @datos
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    process crear-proceso (
        name: Crear usuario
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    v_usuario_id  number;
                begin
                    adm_seg_usuario_api.crear(
                        i_username           => :P31_USERNAME,
                        i_email              => :P31_EMAIL,
                        i_nombres            => :P31_NOMBRES,
                        i_apellidos          => :P31_APELLIDOS,
                        i_tipo_autenticacion => :P31_TIPO_AUTENTICACION,
                        i_password           => :P31_PASSWORD,
                        i_empresa_id_defecto => :P31_EMPRESA_ID,
                        o_usuario_id         => v_usuario_id);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @crear
        }
        successMessage {
            successMessage: Usuario creado. Deberá cambiar la contraseña en su primer ingreso.
        }
    )

    branch ir-a-30 (
        name: Ir a página 30
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 30
            }
        }
    )
)
