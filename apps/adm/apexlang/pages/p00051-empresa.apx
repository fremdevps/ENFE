page 51 (
    name: Empresa
    alias: EMPRESA
    title: Empresa
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @adm-gen-empresa-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición: empresa.
            Los campos marcados son obligatorios.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Empresa
        type: form
        source {
            location: localDatabase
            tableName: ADM_GEN_EMPRESA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P51_EMPRESA_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: EMPRESA_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P51_CODIGO (
        type: textField
        label {
            label: Código
        }
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: CODIGO
            dataType: varchar2
        }
        help {
            inlineHelpText: Código corto único
            helpText: Identificador corto de la empresa; no puede repetirse.
        }
    )

    pageItem P51_RAZON_SOCIAL (
        type: textField
        label {
            label: Razón social
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: RAZON_SOCIAL
            dataType: varchar2
        }
        help {
            inlineHelpText: Nombre legal
            helpText: Razón social tal como figura en los documentos legales.
        }
    )

    pageItem P51_NOMBRE_COMERCIAL (
        type: textField
        label {
            label: Nombre comercial
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: NOMBRE_COMERCIAL
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Nombre comercial o de fantasía.
        }
    )

    pageItem P51_NRO_DOCUMENTO (
        type: textField
        label {
            label: Nro. documento
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: NRO_DOCUMENTO
            dataType: varchar2
        }
        help {
            inlineHelpText: RUC / NIT
            helpText: Número de identificación tributaria.
        }
    )

    pageItem P51_ZONA_HORARIA (
        type: textField
        label {
            label: Zona horaria
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: ZONA_HORARIA
            dataType: varchar2
        }
        help {
            inlineHelpText: Ej. America/Asuncion
            helpText: Zona horaria IANA usada para las fechas de negocio de la empresa.
        }
    )

    pageItem P51_ESTADO (
        type: selectList
        label {
            label: Estado
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @estado-ai
        }
        source {
            formRegion: @formulario
            column: ESTADO
            dataType: varchar2
        }
        help {
            inlineHelpText: Activo o inactivo
            helpText: Las empresas inactivas no se ofrecen en las listas.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button eliminar (
        buttonName: ELIMINAR
        label: Eliminar
        layout {
            sequence: 20
            region: @botones
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            executeValidations: false
            requiresConfirmation: true
        }
        confirmation {
            message: ¿Seguro que desea eliminar este registro?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P51_EMPRESA_ID
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P51_EMPRESA_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P51_EMPRESA_ID
        }
    )

    region historial (
        name: Historial
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(h.fecha, 'DD/MM/YYYY HH24:MI') fecha,
                       h.usuario,
                       h.operacion_desc || ' - ' || h.entidad cambio,
                       h.campo,
                       h.antes,
                       h.despues
                  from (select d.*
                          from adm_aud_cambio_det_v d
                         where d.tabla = 'ADM_GEN_EMPRESA'
                           and d.registro_id = :P51_EMPRESA_ID) h
                 order by h.fecha desc, h.cambio_id desc, h.orden
                ```
        }
        layout {
            sequence: 90
            slot: contentBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
        advanced {
            htmlDomId: historial
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Este registro todavía no tiene cambios registrados.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P51_EMPRESA_ID
        }
        security {
            authorizationScheme: @adm-aud-cambio-ver
        }
        comments {
            comments: Historial de cambios del registro (vista adm_aud_cambio_det_v), solo lectura.
        }

        column FECHA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Fecha
                alignment: start
            }
            layout {
                sequence: 10
                columnAlignment: start
            }
        )

        column USUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
        )

        column CAMBIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Cambio
                alignment: start
            }
            layout {
                sequence: 30
                columnAlignment: start
            }
        )

        column CAMPO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Campo
                alignment: start
            }
            layout {
                sequence: 40
                columnAlignment: start
            }
        )

        column ANTES (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Antes
                alignment: start
            }
            layout {
                sequence: 50
                columnAlignment: start
            }
        )

        column DESPUES (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Después
                alignment: start
            }
            layout {
                sequence: 60
                columnAlignment: start
            }
        )
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Empresa
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process guardar-datos (
        name: Guardar Empresa
        type: formAutoRowProcessing
        formRegion: @formulario
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
