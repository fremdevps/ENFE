page 31 (
    name: Usuario
    alias: USUARIO
    title: Usuario
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @adm-seg-usuario-ver
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Alta y edición de usuarios.
            Al crear, el usuario recibe una contraseña inicial que deberá cambiar. Al editar, puede asignarle roles y resetear su contraseña desde la sección Roles asignados.
            ```
    }

    region botones (
        name: Botones
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region formulario (
        name: Usuario
        type: form
        source {
            location: localDatabase
            tableName: ADM_SEG_USUARIO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    pageItem P31_USUARIO_ID (
        type: hidden
        layout {
            sequence: 10
            region: @formulario
            slot: regionBody
        }
        source {
            formRegion: @formulario
            column: USUARIO_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P31_USERNAME (
        type: textField
        label {
            label: Usuario
        }
        layout {
            sequence: 20
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: USERNAME
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNull
            item: P31_USUARIO_ID
        }
        help {
            inlineHelpText: Se guarda en mayúsculas
            helpText: Nombre con el que iniciará sesión. Debe ser único y no se puede cambiar después.
        }
    )

    pageItem P31_EMAIL (
        type: textField
        label {
            label: Email
        }
        layout {
            sequence: 30
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: EMAIL
            dataType: varchar2
        }
        help {
            inlineHelpText: Correo único
            helpText: Correo electrónico de contacto; no puede repetirse.
        }
    )

    pageItem P31_NOMBRES (
        type: textField
        label {
            label: Nombres
        }
        layout {
            sequence: 40
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @formulario
            column: NOMBRES
            dataType: varchar2
        }
        help {
            inlineHelpText: Nombres de la persona
            helpText: Nombres tal como se mostrarán en las aplicaciones.
        }
    )

    pageItem P31_APELLIDOS (
        type: textField
        label {
            label: Apellidos
        }
        layout {
            sequence: 50
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @formulario
            column: APELLIDOS
            dataType: varchar2
        }
        help {
            inlineHelpText: Opcional
            helpText: Apellidos de la persona.
        }
    )

    pageItem P31_TIPO_AUTENTICACION (
        type: selectList
        label {
            label: Autenticación
        }
        layout {
            sequence: 60
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @tipo-autenticacion
        }
        source {
            formRegion: @formulario
            column: TIPO_AUTENTICACION
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNull
            item: P31_USUARIO_ID
        }
        help {
            inlineHelpText: Local o SSO
            helpText: Local: usa contraseña propia. SSO: se autentica con un proveedor externo.
        }
    )

    pageItem P31_PASSWORD (
        type: password
        label {
            label: Contraseña inicial
        }
        layout {
            sequence: 70
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNull
            item: P31_USUARIO_ID
        }
        help {
            inlineHelpText: Mín. 8, letras y números
            helpText: Solo para usuarios locales. Es temporal: deberá cambiarla en su primer ingreso.
        }
    )

    pageItem P31_EMPRESA_ID_DEFECTO (
        type: selectList
        label {
            label: Empresa por defecto
        }
        layout {
            sequence: 80
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        lov {
            type: sharedComponent
            lov: @empresas
            displayNullValue: true
            nullDisplayValue: - Ninguna -
        }
        source {
            formRegion: @formulario
            column: EMPRESA_ID_DEFECTO
            dataType: number
        }
        help {
            inlineHelpText: Empresa habitual
            helpText: Empresa con la que el usuario trabaja por defecto.
        }
    )

    pageItem P31_ESTADO (
        type: selectList
        label {
            label: Estado
        }
        layout {
            sequence: 90
            region: @formulario
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        lov {
            type: sharedComponent
            lov: @estado-usuario
        }
        source {
            formRegion: @formulario
            column: ESTADO
            dataType: varchar2
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P31_USUARIO_ID
        }
        help {
            inlineHelpText: Activo, inactivo o bloqueado
            helpText: Pase a Activo para desbloquear; Inactivo impide el ingreso sin borrar al usuario.
        }
    )

    button cancelar (
        buttonName: CANCELAR
        label: Cancelar
        layout {
            sequence: 10
            region: @botones
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button guardar (
        buttonName: GUARDAR
        label: Guardar cambios
        layout {
            sequence: 30
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P31_USUARIO_ID
        }
    )

    button crear (
        buttonName: CREAR
        label: Crear
        layout {
            sequence: 40
            region: @botones
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P31_USUARIO_ID
        }
    )

    region historial (
        name: Historial
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select to_char(h.fecha, 'DD/MM/YYYY HH24:MI') fecha,
                       h.usuario,
                       h.operacion_desc || ' - ' || h.entidad cambio,
                       h.campo,
                       h.antes,
                       h.despues
                  from (select d.*
                          from adm_aud_cambio_det_v d
                         where d.tabla = 'ADM_SEG_USUARIO'
                           and d.registro_id = :P31_USUARIO_ID
                        union all
                        select d.*
                          from adm_aud_cambio_det_v d
                         where d.tabla in ('ADM_SEG_USUARIO_ROL')
                           and d.registro_padre_id = :P31_USUARIO_ID) h
                 order by h.fecha desc, h.cambio_id desc, h.orden
                ```
        }
        layout {
            sequence: 90
            slot: contentBody
        }
        appearance {
            template: @/collapsible
            templateOptions: [
                #DEFAULT#
                is-collapsed
            ]
        }
        advanced {
            htmlDomId: historial
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        messages {
            whenNoDataFound: Este registro todavía no tiene cambios registrados.
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P31_USUARIO_ID
        }
        security {
            authorizationScheme: @adm-aud-cambio-ver
        }
        comments {
            comments: Historial de cambios del registro (vista adm_aud_cambio_det_v), solo lectura.
        }

        column FECHA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Fecha
                alignment: start
            }
            layout {
                sequence: 10
                columnAlignment: start
            }
        )

        column USUARIO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Usuario
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
        )

        column CAMBIO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Cambio
                alignment: start
            }
            layout {
                sequence: 30
                columnAlignment: start
            }
        )

        column CAMPO (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Campo
                alignment: start
            }
            layout {
                sequence: 40
                columnAlignment: start
            }
        )

        column ANTES (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Antes
                alignment: start
            }
            layout {
                sequence: 50
                columnAlignment: start
            }
        )

        column DESPUES (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Después
                alignment: start
            }
            layout {
                sequence: 60
                columnAlignment: start
            }
        )
    )

    dynamicAction cerrar-panel (
        name: Cancelar
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancelar
        }

        action cancelar-dialogo (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )

    process inicializar (
        name: Inicializar Usuario
        type: formInitialization
        formRegion: @formulario
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    region roles-asignados (
        name: Roles asignados
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.codigo || ' - ' || r.nombre rol,
                       coalesce(e.razon_social, 'Todas') empresa,
                       to_char(ur.fecha_desde, 'DD/MM/YYYY') desde,
                       coalesce(to_char(ur.fecha_hasta, 'DD/MM/YYYY'), 'Sin vencimiento') hasta
                  from adm_seg_usuario_rol ur
                  join adm_seg_rol r on r.rol_id = ur.rol_id
                  left join adm_gen_empresa e on e.empresa_id = ur.empresa_id
                 where ur.usuario_id = :P31_USUARIO_ID
                 order by r.codigo
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P31_USUARIO_ID
        }
        comments {
            comments: Roles del usuario. Se gestionan con el modal Asignar o quitar rol (página 34).
        }

        column ROL (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Rol
                alignment: start
            }
            layout {
                sequence: 10
                columnAlignment: start
            }
        )

        column EMPRESA (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Empresa
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
        )

        column DESDE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Desde
                alignment: start
            }
            layout {
                sequence: 30
                columnAlignment: start
            }
        )

        column HASTA (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Hasta
                alignment: start
            }
            layout {
                sequence: 40
                columnAlignment: start
            }
        )
    )

    button asignar-rol (
        buttonName: ASIGNAR_ROL
        label: Asignar o quitar rol
        layout {
            sequence: 10
            region: @roles-asignados
            slot: RIGHT_OF_TITLE
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: #DEFAULT#
            icon: fa-user-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 34
                items: {
                    P34_USUARIO_ID: &P31_USUARIO_ID.
                }
                clearCache: 34
            }
        }
        security {
            authorizationScheme: @adm-seg-usuario-gestionar
        }
    )

    button resetear (
        buttonName: RESETEAR
        label: Resetear contraseña
        layout {
            sequence: 10
            region: @roles-asignados
            slot: RIGHT_OF_TITLE
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: #DEFAULT#
            icon: fa-key
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 32
                items: {
                    P32_USUARIO_ID: &P31_USUARIO_ID.
                }
                clearCache: 32
            }
        }
        security {
            authorizationScheme: @adm-seg-usuario-reset-password
        }
    )

    process crear-api (
        name: Crear (api)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                adm_seg_usuario_api.crear(
                    i_username           => :P31_USERNAME,
                    i_email              => :P31_EMAIL,
                    i_nombres            => :P31_NOMBRES,
                    i_apellidos          => :P31_APELLIDOS,
                    i_tipo_autenticacion => :P31_TIPO_AUTENTICACION,
                    i_password           => :P31_PASSWORD,
                    i_empresa_id_defecto => :P31_EMPRESA_ID_DEFECTO,
                    o_usuario_id         => :P31_USUARIO_ID);
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @crear
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process guardar-api (
        name: Guardar (api)
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                adm_seg_usuario_api.modificar(
                    i_usuario_id         => :P31_USUARIO_ID,
                    i_email              => :P31_EMAIL,
                    i_nombres            => :P31_NOMBRES,
                    i_apellidos          => :P31_APELLIDOS,
                    i_empresa_id_defecto => :P31_EMPRESA_ID_DEFECTO,
                    i_estado             => :P31_ESTADO);
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
        successMessage {
            successMessage: Cambios guardados.
        }
    )

    process cerrar (
        name: Cerrar panel
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREAR,GUARDAR,ELIMINAR
        }
    )
)
