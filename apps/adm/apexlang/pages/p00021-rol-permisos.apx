page 21 (
    name: Permisos por rol
    alias: ROL-PERMISOS
    title: Permisos por rol
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-seg-rol-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Asigne permisos a cada rol.
            Cada fila otorga un permiso a un rol; los cambios aplican en el próximo inicio de sesión de los usuarios.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region rol-permisos (
        name: Permisos por rol
        type: interactiveGrid
        advanced {
            htmlDomId: rol-permisos
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rol_permiso_id, rol_id, permiso_id
                  from adm_seg_rol_permiso
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }
        comments {
            comments:
                ```
                Mantenimiento de adm_seg_rol_permiso (N:M).
                ```
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column ROL_PERMISO_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ROL_PERMISO_ID
                dataType: number
                primaryKey: true
            }
        )

        column ROL_ID (
            type: selectList
            heading {
                heading: Rol
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ROL_ID
                dataType: number
            }
            lov {
                type: sharedComponent
                lov: @roles
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Rol. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column PERMISO_ID (
            type: selectList
            heading {
                heading: Permiso
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: PERMISO_ID
                dataType: number
            }
            lov {
                type: sharedComponent
                lov: @permisos
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Permiso. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    process rol-permisos-guardar (
        name: Guardar Permisos por rol
        type: interactiveGridAutoRowProcessing
        editableRegion: @rol-permisos
        execution {
            sequence: 10
        }
    )
)
