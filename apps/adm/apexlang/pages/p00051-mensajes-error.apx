page 51 (
    name: Mensajes de error
    alias: MENSAJES-ERROR
    title: Mensajes de error
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-gen-mensaje-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Mensajes claros que ve el usuario cuando un dato viola una regla de la base de datos.
            El código es el nombre del constraint (ej. UK_ADM_USU_USERNAME). Aplica a todas las aplicaciones.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region mensajes-error (
        name: Mensajes de error
        type: interactiveGrid
        advanced {
            htmlDomId: mensajes-error
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select mensaje_error_id, codigo, mensaje
                  from adm_gen_mensaje_error
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }
        comments {
            comments:
                ```
                Catálogo usado por adm_gen_error_api.manejar_error_apex.
                ```
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column MENSAJE_ERROR_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: MENSAJE_ERROR_ID
                dataType: number
                primaryKey: true
            }
        )

        column CODIGO (
            type: textField
            heading {
                heading: Constraint
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CODIGO
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Summary: Nombre exacto del constraint en mayúsculas. Display Label: Constraint. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column MENSAJE (
            type: textField
            heading {
                heading: Mensaje para el usuario
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: MENSAJE
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Mensaje para el usuario. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    process mensajes-error-guardar (
        name: Guardar Mensajes de error
        type: interactiveGridAutoRowProcessing
        editableRegion: @mensajes-error
        execution {
            sequence: 10
        }
    )
)
