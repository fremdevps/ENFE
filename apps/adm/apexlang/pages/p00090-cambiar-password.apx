page 90 (
    name: Cambiar mi contraseña
    alias: CAMBIAR-PASSWORD
    title: Cambiar mi contraseña
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Cambie su contraseña de acceso.
            Es obligatorio en el primer ingreso o después de un reseteo. Use al menos 8 caracteres con letras y números.
            ```
    }

    region datos (
        name: Cambiar mi contraseña
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P90_PASSWORD_ACTUAL (
        type: password
        label {
            label: Contraseña actual
        }
        layout {
            sequence: 10
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Su contraseña vigente
            helpText: Contraseña con la que ingresó (o la temporal recibida).
        }
    )

    pageItem P90_PASSWORD_NUEVO (
        type: password
        label {
            label: Nueva contraseña
        }
        layout {
            sequence: 20
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Mín. 8, letras y números
            helpText: Debe ser distinta a la actual.
        }
    )

    pageItem P90_PASSWORD_CONFIRMA (
        type: password
        label {
            label: Confirmar nueva contraseña
        }
        layout {
            sequence: 30
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Repita la nueva
            helpText: Escriba nuevamente la nueva contraseña.
        }
    )

    button cambiar (
        buttonName: CAMBIAR
        label: Cambiar contraseña
        layout {
            sequence: 10
            region: @datos
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    process cambiar-proceso (
        name: Cambiar contraseña
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    adm_seg_usuario_api.cambiar_password(
                        i_username          => :APP_USER,
                        i_password_actual   => :P90_PASSWORD_ACTUAL,
                        i_password_nuevo    => :P90_PASSWORD_NUEVO,
                        i_password_confirma => :P90_PASSWORD_CONFIRMA);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @cambiar
        }
        successMessage {
            successMessage: Contraseña actualizada.
        }
    )

    branch ir-a-1 (
        name: Ir a página 1
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 1
            }
        }
    )
)
