page 90 (
    name: Cambiar mi contraseña
    alias: CAMBIAR-PASSWORD
    title: Cambiar mi contraseña
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: firstItemOnPage
    }
    security {

        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region datos (
        name: Cambiar mi contraseña
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P90_PASSWORD_ACTUAL (
        type: password
        label {
            label: Contraseña actual
        }
        layout {
            sequence: 10
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P90_PASSWORD_NUEVO (
        type: password
        label {
            label: Nueva contraseña
        }
        layout {
            sequence: 20
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P90_PASSWORD_CONFIRMA (
        type: password
        label {
            label: Confirmar nueva contraseña
        }
        layout {
            sequence: 30
            region: @datos
            slot: regionBody
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
    )

    button cambiar (
        buttonName: CAMBIAR
        label: Cambiar contraseña
        layout {
            sequence: 10
            region: @datos
            slot: CREATE
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
    )

    process cambiar-password (
        name: Cambiar contraseña
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :P90_PASSWORD_NUEVO <> :P90_PASSWORD_CONFIRMA then
                        raise_application_error(-20014, 'La confirmación no coincide con la nueva contraseña.');
                    end if;
                    adm_seguridad_reg.P_CAMBIAR_PASSWORD_USUARIO(
                        I_USERNAME        => :APP_USER,
                        I_PASSWORD_ACTUAL => :P90_PASSWORD_ACTUAL,
                        I_PASSWORD_NUEVO  => :P90_PASSWORD_NUEVO);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @cambiar
        }
        successMessage {
            successMessage: Contraseña actualizada.
        }
    )

    branch ir-a-1 (
        name: Ir a página 1
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 1
            }
        }
    )
)
