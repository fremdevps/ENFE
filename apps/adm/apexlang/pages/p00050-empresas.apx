page 50 (
    name: Empresas
    alias: EMPRESAS
    title: Empresas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @adm-gen-empresa-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Empresas o unidades de negocio.
            Los roles pueden asignarse por empresa y las fechas de negocio usan su zona horaria.
            ```
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region empresas (
        name: Empresas
        type: interactiveGrid
        advanced {
            htmlDomId: empresas
        }
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select empresa_id, codigo, razon_social, nombre_comercial, nro_documento, zona_horaria, estado
                  from adm_gen_empresa
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No hay datos
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        download {
            formats: [
                csv
                excel
            ]
        }
        comments {
            comments:
                ```
                Mantenimiento de adm_gen_empresa.
                ```
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 20
            }
        )

        column EMPRESA_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: EMPRESA_ID
                dataType: number
                primaryKey: true
            }
        )

        column CODIGO (
            type: textField
            heading {
                heading: Código
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CODIGO
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: true. Authorization Scheme: none.
            }
        )

        column RAZON_SOCIAL (
            type: textField
            heading {
                heading: Razón social
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: RAZON_SOCIAL
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Razón social. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE_COMERCIAL (
            type: textField
            heading {
                heading: Nombre comercial
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: NOMBRE_COMERCIAL
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Nombre comercial. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NRO_DOCUMENTO (
            type: textField
            heading {
                heading: Nro. documento
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: NRO_DOCUMENTO
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Nro. documento. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ZONA_HORARIA (
            type: textField
            heading {
                heading: Zona horaria
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ZONA_HORARIA
                dataType: varchar2
            }
            columnFilter {
                enabled: true
                lovType: none
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Summary: Formato IANA, ej. America/Asuncion. Display Label: Zona horaria. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: selectList
            heading {
                heading: Estado
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ESTADO
                dataType: varchar2
            }
            lov {
                type: sharedComponent
                lov: @estado-ai
            }
            columnFilter {
                enabled: true
                lovType: useLov
            }
            enableUsersTo {
                sort: true
                controlBreakAggregate: true
                hide: true
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: true. Read Only: false. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    process empresas-guardar (
        name: Guardar Empresas
        type: interactiveGridAutoRowProcessing
        editableRegion: @empresas
        execution {
            sequence: 10
        }
    )
)
