page 50 (
    name: Empresas
    alias: EMPRESAS
    title: Empresas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @adm-gen-empresa-gestionar
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText:
            ```
            Empresas o unidades de negocio.
            Use Crear empresa para agregar o el lápiz de cada fila para editar.
            ```
    }

    region breadcrumb (
        name: Empresas
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region empresas (
        name: Empresas
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select empresa_id, codigo, razon_social, nombre_comercial, nro_documento, zona_horaria,
                       decode(estado, 'A', 'Activo', 'Inactivo') estado
                  from adm_gen_empresa
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: empresas
        }
        link {
            linkColumn: customTarget
            target: {
                page: 51
                items: {
                    P51_EMPRESA_ID: #EMPRESA_ID#
                }
                clearCache: 51
            }
            linkIcon: <span role="img" aria-label="Editar" class="fa fa-edit" title="Editar"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No hay registros.
            whenMoreDataFound: Hay más de #MAX_ROW_COUNT# registros; use la búsqueda o los filtros.
        }
        download {
            formats: [
                csv
                html
            ]
        }
        comments {
            comments:
                ```
                Listado de adm_gen_empresa. Alta/edición en la página 51 (guardado automático: catálogo simple).
                ```
        }

        column EMPRESA_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column CODIGO (
            type: plainText
            heading {
                heading: Código
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Código. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column RAZON_SOCIAL (
            type: plainText
            heading {
                heading: Razón social
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Razón social. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NOMBRE_COMERCIAL (
            type: plainText
            heading {
                heading: Nombre comercial
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nombre comercial. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column NRO_DOCUMENTO (
            type: plainText
            heading {
                heading: Nro. documento
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Nro. documento. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ZONA_HORARIA (
            type: plainText
            heading {
                heading: Zona horaria
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Zona horaria. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )

        column ESTADO (
            type: plainText
            heading {
                heading: Estado
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            comments {
                comments: Display Label: Estado. Display in Report: true. Display in Form: true. Format Mask: none. Value Required: false. Read Only: true. Primary Display Column: false. Authorization Scheme: none.
            }
        )
    )

    button crear (
        buttonName: CREAR
        label: Crear empresa
        layout {
            sequence: 10
            region: @empresas
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 51
                clearCache: 51
            }
        }
    )

    dynamicAction refrescar-al-cerrar (
        name: Refrescar al cerrar el formulario
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @empresas
        }

        action refrescar (
            action: refresh
            affectedElements {
                selectionType: region
                region: @empresas
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
